                return () => unsubscribe();
            }, []);

            const handleGoogleLogin = async () => {
                if (isLoading) return;
                setIsLoading(true);
                accountLoginFlowActive = true;
                try {
                    if (!['http:', 'https:'].includes(window.location.protocol)) {
                        throw new Error('Login Google harus dibuka melalui alamat website HTTPS.');
                    }
                    const provider = new firebase.auth.GoogleAuthProvider();
                    provider.setCustomParameters({ prompt: 'select_account' });
                    const credential = await auth.signInWithPopup(provider);
                    await ensureGkinhubChurchProfile(credential.user, 'google.com');
                } catch (error) {
                    if (error.code !== 'gkinhub/profile-setup-cancelled') {
                        console.error('Login Google GKIN HUB gagal:', error.code || '', error);
                        let message = 'Login Google gagal. Silakan coba kembali.';
                        if (error.code === 'auth/popup-closed-by-user') message = 'Jendela login Google ditutup sebelum proses selesai.';
                        else if (error.code === 'auth/unauthorized-domain') message = 'Domain website belum diizinkan di Firebase Authentication > Settings > Authorized domains.';
                        else if (error.code === 'auth/account-exists-with-different-credential') message = 'Email ini sudah terdaftar dengan metode login lain. Gunakan metode login yang sudah terhubung dengan akun tersebut.';
                        else if (error.code === 'functions/failed-precondition' || error.code === 'functions/permission-denied') message = error.message || 'Akun tidak memiliki izin untuk membuat gereja.';
                        else if (error.code === 'functions/not-found') message = 'Fungsi backend GKINHUB belum dideploy. Deploy Firebase Cloud Functions terlebih dahulu.';
                        else if (error.code === 'permission-denied') message = 'Firestore menolak akses profil. Periksa Firestore Rules GKINHUB.';
                        else if (error.message) message = error.message;
                        onShowAlert(message, 'error');
