                            </div>
                            <div className="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-100">
                                <button type="button" onClick={onClose} className="w-full sm:w-auto px-5 py-2.5 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg font-medium">Batal</button>
                                <button type="submit" disabled={bulkData.length===0} className="w-full sm:w-auto px-5 py-2.5 bg-[#0b5e46] text-white rounded-lg font-medium shadow-sm disabled:opacity-50">Simpan {bulkData.length} Jadwal</button>
                            </div>
                        </form>
                    )}
                </Modal>
            );
        };

        const ModalPengguna = ({ isOpen, onClose, onSave, onShowAlert }) => {
            const [isLoading, setIsLoading] = useState(false);
            const handleSubmit = async (e) => {
                e.preventDefault();
                if (isLoading) return;
                setIsLoading(true);
                const fd = new FormData(e.target);
                const nama = String(fd.get('nama') || '').trim();
                const role = String(fd.get('role') || 'Staf');
                try {
                    if (!activeGerejaId) throw new Error('Gereja aktif tidak ditemukan.');
                    if (!auth.currentUser) throw new Error('Sesi Administrator sudah berakhir. Silakan login kembali.');
                    let loginId = createStaffLoginId(role);
                    const loginEmail = staffEmailFromId(loginId);
                    await secondaryAuth.signOut().catch(() => {});
                    const staffCredential = await secondaryAuth.createUserWithEmailAndPassword(loginEmail, staffAuthPassword('1234'));
                    const uid = staffCredential.user.uid;
                    try {
                        const profileRef = db.collection('users').doc(uid);
                        const indexRef = staffIndexRef(loginId);
                        await db.runTransaction(async (tx) => {
                            const indexSnap = await tx.get(indexRef);
                            if (indexSnap.exists) throw new Error('ID staf sudah digunakan. Silakan coba buat akun sekali lagi.');
                            tx.set(profileRef, {
                                id: uid, uid, email: loginEmail, nama, loginId, gerejaId: activeGerejaId,
                                role, status: 'Aktif', mustChangePin: true,
                                createdAt: firebase.firestore.FieldValue.serverTimestamp(),
                                createdBy: auth.currentUser.uid
                            });
                            tx.set(indexRef, {
                                loginId, uid, email: loginEmail, gerejaId: activeGerejaId,
                                status: 'Aktif', createdAt: firebase.firestore.FieldValue.serverTimestamp()
                            });
                        });
                    } catch (writeError) {
                        try { await staffCredential.user.delete(); } catch (_) {}
                        throw writeError;
                    } finally {
                        await secondaryAuth.signOut().catch(() => {});
                    }
                    const createdProfile = { id: uid, uid, email: loginEmail, nama, loginId, gerejaId: activeGerejaId, role, status: 'Aktif', mustChangePin: true };
                    onSave(createdProfile);
                    onShowAlert(`Akun staf berhasil dibuat.\nID Pengguna: ${loginId}\nPIN awal: 1234\nPIN wajib diganti saat login pertama.\n\nCatatan: akun ini dibuat di Firebase Authentication yang sama dengan WebPresenter Pro.`, 'info');
                    e.target.reset();
                    onClose();
                } catch (error) {
                    console.error('Gagal membuat pengguna GKINHUB:', error);
                    onShowAlert(error.message || 'Gagal membuat akun staf.', 'error');
