        // ==========================================
        // MAIN APP COMPONENT
        // ==========================================
        const App = () => {
            const [currentUser, setCurrentUser] = useState(null); 
            const [activeTab, setActiveTab] = useState('Dashboard'); 
            const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
            const [modals, setModals] = useState({ tx: false, txEdit: false, jemaat: false, jadwal: false, user: false });
            const [editingTx, setEditingTx] = useState(null);
            const [alertState, setAlertState] = useState({ show: false, message: '', type: 'info' });
            const [confirmState, setConfirmState] = useState({ show: false, message: '', onConfirm: () => {} });

            const showAlert = (message, type = 'info') => setAlertState({ show: true, message, type });
            const showConfirm = (message, onConfirm) => setConfirmState({ show: true, message, onConfirm });

            const changeOwnPin = async (forceInitial = false) => {
                const exitIfForced = async () => {
                    if (forceInitial) {
                        showAlert('PIN awal harus diganti sebelum menggunakan GKINHUB. Silakan masuk kembali dan selesaikan perubahan PIN.', 'warning');
                        try { await auth.signOut(); } catch (_) {}
                    }
                };
                const oldPin = forceInitial ? '1234' : window.prompt('Masukkan PIN lama:');
                if (oldPin === null || oldPin === undefined) { await exitIfForced(); return false; }
                const newPin = window.prompt('Masukkan PIN baru (4-8 angka, bukan 1234):');
                if (newPin === null) { await exitIfForced(); return false; }
                const confirmPin = window.prompt('Ulangi PIN baru:');
                if (confirmPin === null) { await exitIfForced(); return false; }
                if (!/^\d{4,8}$/.test(String(newPin)) || String(newPin) === '1234') {
                    showAlert('PIN baru harus 4-8 angka dan tidak boleh 1234.', 'error');
                    await exitIfForced();
                    return false;
                }
                if (newPin !== confirmPin) {
                    showAlert('PIN baru dan pengulangan tidak sama.', 'error');
                    await exitIfForced();
                    return false;
                }
                try {
                    const staffUser = auth.currentUser;
                    if (!staffUser || !staffUser.email || !currentUser.loginId) {
                        throw new Error('Ganti PIN hanya tersedia untuk akun staf yang login menggunakan ID Pengguna.');
                    }
                    const credential = firebase.auth.EmailAuthProvider.credential(staffUser.email, staffAuthPassword(oldPin));
                    await staffUser.reauthenticateWithCredential(credential);
                    await staffUser.updatePassword(staffAuthPassword(newPin));
                    await db.collection('users').doc(staffUser.uid).update({
                        mustChangePin: false,
                        updatedAt: firebase.firestore.FieldValue.serverTimestamp()
                    });
                    showAlert('PIN berhasil diperbarui. Gunakan PIN baru saat login berikutnya.', 'info');
                    return true;
                } catch (error) {
                    console.error('Gagal mengganti PIN:', error);
                    showAlert(error.message || 'Gagal mengganti PIN.', 'error');
                    await exitIfForced();
                    return false;
                }
            };

            const resetUserPin = async (targetUid) => {
                try {
                    const targetSnap = await db.collection('users').doc(targetUid).get();
                    if (!targetSnap.exists) throw new Error('Akun staf tidak ditemukan.');
                    const target = targetSnap.data() || {};
                    if (!target.loginId || !target.email) throw new Error('Akun ini tidak memakai login ID/PIN staf.');
                    showAlert(
                        'Firebase Spark tidak mengizinkan Administrator mengganti password akun Auth pengguna lain dari browser.\n\n' +
                        'Untuk reset PIN: Firebase Console > Authentication > Users, cari email akun: ' + target.email +
                        '\nLalu reset password menjadi GKINHUB#1234. Pengguna login memakai ID ' + target.loginId + ' dan PIN 1234, kemudian wajib menggantinya.',
                        'warning'
                    );
                } catch (error) {
                    console.error('Tidak dapat menyiapkan reset PIN:', error);
                    showAlert(error.message || 'Tidak dapat reset PIN.', 'error');
                }
            };

            const [transactions, setTransactions] = useState([]);
            const [jemaatData, setJemaatData] = useState([]);
            const [jadwalData, setJadwalData] = useState([]);
            const [usersData, setUsersData] = useState([]);
            const [isFirebaseReady, setIsFirebaseReady] = useState(false);

            useEffect(() => {
                let unsubscribeUserSnapshot = null;
                let unsubTx = null;
                let unsubJemaat = null;
                let unsubJadwal = null;
                let isMounted = true;

                // Jangan biarkan halaman kosong apabila pemulihan sesi Firebase lambat.
                const authInitFallback = setTimeout(() => {
                    if (isMounted) setIsFirebaseReady(true);
                }, 8000);

                const unsubscribeAuth = auth.onAuthStateChanged(async (user) => {
                    clearTimeout(authInitFallback);
                    if (!user) {
                        setCurrentUser(null);
                        activeGerejaId = null;
                        if (unsubscribeUserSnapshot) unsubscribeUserSnapshot();
                        if (unsubTx) unsubTx();
                        if (unsubJemaat) unsubJemaat();
                        if (unsubJadwal) unsubJadwal();
                        if (isMounted) setIsFirebaseReady(true);
                        return;
                    }

                    try {
                        // Login Google/email membuat profil setelah autentikasi berhasil.
                        // Tunggu proses itu selesai agar listener tidak mendahului penulisan profil.
                        const waitUntilGoogleFlowEnds = async () => {
                            const deadline = Date.now() + 120000;
                            while (accountLoginFlowActive && Date.now() < deadline) {
                                await new Promise(resolve => setTimeout(resolve, 200));
                            }
                        };
                        await waitUntilGoogleFlowEnds();

                        // Pengguna mungkin menutup / membatalkan alur Google saat listener menunggu.
                        if (!auth.currentUser || auth.currentUser.uid !== user.uid) {
                            if (isMounted) setIsFirebaseReady(true);
                            return;
                        }

                        const userRef = db.collection('users').doc(user.uid);
                        const readTimeout = new Promise((_, reject) => {
                            setTimeout(() => reject(new Error('FIRESTORE_TIMEOUT')), 15000);
                        });
                        const doc = await Promise.race([userRef.get(), readTimeout]);
                        if (!doc.exists) {
                            throw new Error('PROFILE_NOT_REGISTERED');
                        }

                        const profile = doc.data() || {};
                        if (!profile.gerejaId) throw new Error('PROFILE_MISSING_CHURCH');
                        activeGerejaId = profile.gerejaId;

                        if (unsubscribeUserSnapshot) unsubscribeUserSnapshot();
                        if (unsubTx) unsubTx();
                        if (unsubJemaat) unsubJemaat();
                        if (unsubJadwal) unsubJadwal();

                        unsubscribeUserSnapshot = userRef.onSnapshot(snapshot => {
                            if (snapshot.exists && isMounted) {
                                const profileData = { uid: user.uid, ...snapshot.data() };
                                setCurrentUser(profileData);
                                setActiveTab('Dashboard');
                                if (profileData.mustChangePin && !pinChangePrompted.has(user.uid)) {
                                    pinChangePrompted.add(user.uid);
                                    setTimeout(() => changeOwnPin(true), 500);
                                }
                            }
                        }, error => {
                            console.error('Gagal memantau profil GKIN HUB:', error);
                            showAlert('Tidak dapat memantau profil pengguna: ' + error.message, 'error');
                        });

                        unsubTx = churchCollection('transactions').onSnapshot(
                            snap => isMounted && setTransactions(snap.docs.map(doc => ({ id: doc.id, ...doc.data() }))),
                            error => console.error('Gagal memuat transaksi gereja:', error)
                        );
                        unsubJemaat = churchCollection('jemaat').onSnapshot(
                            snap => isMounted && setJemaatData(snap.docs.map(doc => ({ id: doc.id, ...doc.data() }))),
                            error => console.error('Gagal memuat data jemaat:', error)
                        );
                        unsubJadwal = churchCollection('jadwal').onSnapshot(
                            snap => isMounted && setJadwalData(snap.docs.map(doc => ({ id: doc.id, ...doc.data() }))),
                            error => console.error('Gagal memuat jadwal gereja:', error)
                        );
                    } catch (err) {
                        console.error('Gagal memuat profil GKIN HUB:', err);
                        if (err.message === 'FIRESTORE_TIMEOUT') {
                            showAlert('Koneksi Firestore terlalu lama. Periksa koneksi internet dan Firestore Rules.', 'error');
                        } else if (err.message === 'PROFILE_NOT_REGISTERED') {
                            showAlert('Login Firebase berhasil, tetapi profil GKIN HUB belum tersedia. Untuk akun baru, gunakan pendaftaran gereja atau minta Administrator memasangkan akun Anda.', 'error');
                        } else if (err.message === 'PROFILE_MISSING_CHURCH') {
                            showAlert('Profil pengguna belum terhubung ke gereja. Administrator perlu melengkapi gerejaId akun ini.', 'error');
                        } else {
                            showAlert('Gagal memuat profil GKIN HUB: ' + err.message, 'error');
                        }
                        // Jangan tinggalkan sesi setengah aktif dengan hak akses yang belum tervalidasi.
                        try { await auth.signOut(); } catch (signOutError) {
                            console.warn('Tidak dapat membersihkan sesi Firebase:', signOutError);
                        }
                    } finally {
                        if (isMounted) setIsFirebaseReady(true);
                    }
                }, error => {
                    console.error('Firebase Auth gagal diinisialisasi:', error);
                    if (isMounted) {
                        showAlert('Tidak dapat memeriksa sesi login Firebase. Muat ulang halaman atau periksa koneksi.', 'error');
                        setIsFirebaseReady(true);
                    }
                });

                return () => {
                    isMounted = false;
                    clearTimeout(authInitFallback);
                    unsubscribeAuth();
                    if (unsubscribeUserSnapshot) unsubscribeUserSnapshot();
                    if (unsubTx) unsubTx();
                    if (unsubJemaat) unsubJemaat();
                    if (unsubJadwal) unsubJadwal();
                };
            }, []);

            useEffect(() => {
                if (currentUser && ['Administrator', 'Sekretaris'].includes(currentUser.role)) {
                    const unsubscribeDB = db.collection('users').where('gerejaId', '==', currentUser.gerejaId).onSnapshot(snapshot => {
                        setUsersData(snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })));
                    });
                    return () => unsubscribeDB();
                }
            }, [currentUser]);

            const handleSaveTxFirestore = async (data) => {
                try {
                    const withTenant = (item) => ({ ...item, gerejaId: activeGerejaId });
                    if (Array.isArray(data)) {
                        const batch = db.batch();
                        data.forEach(item => { const ref = churchCollection('transactions').doc(item.id); batch.set(ref, withTenant(item)); });
                        await batch.commit();
                    } else {
                        await churchCollection('transactions').doc(data.id).set(withTenant(data));
                    }
                    showAlert("Transaksi berhasil disimpan ke database Cloud!", "info");
                } catch(e) { showAlert("Gagal menyimpan transaksi: " + e.message, "error"); }
            };
            
            const handleImportWartaFirestore = async (data, sourceFileName) => {
                const reportMonth = String(data.reportMonth || '');
                if (!/^\d{4}-\d{2}$/.test(reportMonth)) throw new Error('Periode laporan tidak valid.');
                const lastDay = new Date(Number(reportMonth.slice(0, 4)), Number(reportMonth.slice(5, 7)), 0).getDate();
                const postingDate = `${reportMonth}-${String(lastDay).padStart(2, '0')}`;
                const slug = (value) => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9_-]+/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 48) || 'item';
                const importedTransactions = [];
                (data.serviceEntries || []).forEach((entry) => {
                    const channel = String(entry.channel || 'Lain-lain');
                    const date = String(entry.date || `${reportMonth}-01`);
                    const transactionId = `warta_${reportMonth}_${slug(entry.service)}_${date}_${slug(channel)}`;
                    const category = channel === 'Perpuluhan' ? 'Perpuluhan' : (['Syukur', 'Lain-lain', 'Emeritus', 'Gerakan 1000'].includes(channel) ? 'Lain-lain' : 'Persembahan Ibadah');
                    importedTransactions.push({
                        id: transactionId,
                        jenis: 'Pemasukan',
                        tanggal: /^\d{4}-\d{2}-\d{2}$/.test(date) ? date : `${reportMonth}-01`,
                        kategori: category,
                        rincian: `${entry.service} (${channel})`,
                        keterangan: `Diimpor dari ${sourceFileName || 'Warta Jemaat PDF'}; periode ${reportMonth}; hadir ${Number(entry.attendance) || 0}; sumber: rincian persembahan per ibadah.`,
                        nominal: Math.round(Number(entry.amount) || 0),
                        importSource: 'warta-gemini',
                        importPeriod: reportMonth
                    });
                });
                (data.expenseEntries || []).forEach((entry) => {
                    const description = String(entry.description || 'Pengeluaran dari Warta Jemaat');
                    const lower = description.toLowerCase();
                    let category = 'Operasional & Rutin';
                    if (lower.includes('gaji') || lower.includes('tap gembala') || lower.includes('bpjs') || lower.includes('emeritus') || lower.includes('sinode') || lower.includes('g 1.000') || lower.includes('g1.000')) category = 'Gaji & Honor';
                    else if (lower.includes('defisit')) category = 'Lain-lain';
                    else if (lower.includes('bohlam') || lower.includes('kabel') || lower.includes('saklar')) category = 'Operasional & Rutin';
                    importedTransactions.push({
                        id: `warta_${reportMonth}_expense_${slug(description)}`,
                        jenis: 'Pengeluaran',
                        // Warta menampilkan pengeluaran bulanan tanpa tanggal per transaksi.
                        // Tanggal akhir bulan dipakai sebagai tanggal posting administratif, bukan tanggal kejadian.
                        tanggal: postingDate,
                        kategori: category,
                        rincian: description,
                        keterangan: `Diimpor dari ${sourceFileName || 'Warta Jemaat PDF'}; periode ${reportMonth}. Warta tidak mencantumkan tanggal transaksi individual; tanggal akhir bulan digunakan untuk pengelompokan laporan.`,
                        nominal: Math.round(Number(entry.amount) || 0),
                        importSource: 'warta-gemini',
                        importPeriod: reportMonth
                    });
                });
                if (!importedTransactions.length) throw new Error('Tidak ada transaksi positif yang bisa diimpor.');
                importedTransactions.forEach(tx => { tx.gerejaId = activeGerejaId; });
                const reportRef = churchCollection('wartaImports').doc(reportMonth);
                const previousReport = await reportRef.get();
                if (previousReport.exists && !window.confirm(`Sudah ada hasil impor Warta untuk ${reportMonth}. Impor ulang akan mengganti transaksi yang berasal dari impor Warta periode ini. Lanjutkan?`)) return false;
                const previousIds = previousReport.exists && Array.isArray(previousReport.data().transactionIds) ? previousReport.data().transactionIds : [];
                const newIds = new Set(importedTransactions.map(tx => tx.id));
                const batch = db.batch();
                previousIds.filter(id => !newIds.has(id)).forEach(id => batch.delete(churchCollection('transactions').doc(id)));
                importedTransactions.forEach(tx => batch.set(churchCollection('transactions').doc(tx.id), tx));
                batch.set(reportRef, {
                    reportMonth,
                    gerejaId: activeGerejaId,
                    sourceBulletinMonth: data.sourceBulletinMonth || null,
                    sourceFileName: sourceFileName || 'Warta Jemaat PDF',
                    transactionIds: importedTransactions.map(tx => tx.id),
                    serviceEntries: data.serviceEntries || [],
                    expenseEntries: data.expenseEntries || [],
                    summaryIncome: data.summaryIncome || [],
                    reportedTotalIncome: Number(data.reportedTotalIncome) || 0,
                    reportedTotalExpenses: Number(data.reportedTotalExpenses) || 0,
                    reportedDeficit: Number(data.reportedDeficit) || 0,
                    notes: data.notes || { syukur: '', perpuluhan: '', lainLain: '' },
                    warnings: data.warnings || [],
                    importedBy: (currentUser && currentUser.uid) || '',
                    importedAt: firebase.firestore.FieldValue.serverTimestamp(),
                    importEngine: 'Google AI Studio Gemini'
                });
                await batch.commit();
                showAlert(`Warta periode ${reportMonth} tersimpan. ${data.serviceEntries.length} rincian pemasukan dan ${data.expenseEntries.length} pengeluaran diimpor; ringkasan dan catatan disimpan tanpa menggandakan transaksi.`, 'info');
                return true;
            };

            const handleUpdateTxFirestore = async (updatedData) => {
                try {
                    await churchCollection('transactions').doc(updatedData.id).update({ ...updatedData, gerejaId: activeGerejaId });
                    showAlert("Data transaksi berhasil diperbarui!", "info");
                    toggleModalSafe('txEdit', false);
                    setEditingTx(null);
                } catch(e) { showAlert("Gagal memperbarui transaksi: " + e.message, "error"); }
            };

            const handleDeleteTxFirestore = async (id) => {
                try { await churchCollection('transactions').doc(id).delete(); showAlert("Transaksi berhasil dihapus.", "info"); } 
                catch(e) { showAlert("Gagal menghapus: " + e.message, "error"); }
            };

            const handleSaveJemaatFirestore = async (data) => {
                try { await churchCollection('jemaat').doc(data.id).set({ ...data, gerejaId: activeGerejaId }); showAlert("Data jemaat tersimpan di Cloud!", "info"); } 
                catch(e) { showAlert("Gagal menyimpan: " + e.message, "error"); }
            };

            const handleDeleteJemaatFirestore = async (id) => {
                try { await churchCollection('jemaat').doc(id).delete(); showAlert("Data Jemaat dihapus.", "info"); } 
                catch(e) { showAlert("Gagal menghapus: " + e.message, "error"); }
            };

            const handleSaveJadwalFirestore = async (data) => {
                try { 
                    if (Array.isArray(data)) {
                        const batch = db.batch();
                        data.forEach(item => { const ref = churchCollection('jadwal').doc(item.id); batch.set(ref, { ...item, gerejaId: activeGerejaId }); });
                        await batch.commit();
                        showAlert(`${data.length} Jadwal tersimpan di Cloud!`, "info");
                    } else {
                        await churchCollection('jadwal').doc(data.id).set({ ...data, gerejaId: activeGerejaId }); 
                        showAlert("Jadwal tersimpan di Cloud!", "info"); 
                    }
                } catch(e) { showAlert("Gagal menyimpan: " + e.message, "error"); }
            };

            const handleDeleteJadwalFirestore = async (id) => {
                try { await churchCollection('jadwal').doc(id).delete(); showAlert("Jadwal dihapus.", "info"); } 
                catch(e) { showAlert("Gagal menghapus: " + e.message, "error"); }
            };

            const handleDeleteUserFirestore = async (id) => {
                try {
                    const userRef = db.collection('users').doc(id);
                    const snap = await userRef.get();
                    if (!snap.exists) throw new Error('Pengguna tidak ditemukan.');
                    const data = snap.data() || {};
                    const batch = db.batch();
                    if (data.loginId) batch.delete(staffIndexRef(data.loginId));
                    batch.delete(userRef);
                    await batch.commit();
                    showAlert('Profil GKINHUB dan ID login staf telah dihapus. Akun Firebase Authentication tidak bisa dihapus oleh browser pada paket Spark; akun tersebut tidak lagi dapat masuk GKINHUB karena profilnya sudah dicabut.', 'info');
                } catch (err) { showAlert('Gagal menghapus: ' + err.message, 'error'); }
            };

            const handleUpdateUserRole = async (id, newRole) => {
                try { await db.collection('users').doc(id).update({ role: newRole }); showAlert("Hak akses pengguna berhasil diperbarui!", "info"); } 
                catch (err) { showAlert("Gagal memperbarui role: " + err.message, "error"); }
            };

            const handleCairkanGaji = (gaji, tap, bulan) => {
                if (gaji <= 0 && tap <= 0) { showAlert("Belum ada pemasukan di bulan ini untuk dicairkan.", "error"); return; }
                showConfirm(`Catat pengeluaran otomatis untuk Gaji Gembala (${formatRp(gaji)}) & TAP Gembala (${formatRp(tap)}) ke dalam sistem pembukuan?`, () => {
                    const today = new Date().toISOString().split('T')[0];
                    const txGaji = { id: generateId() + 'A', tanggal: today, jenis: 'Pengeluaran', kategori: 'Gaji & Honor', rincian: 'Gaji Gembala', keterangan: `Pencairan Gaji Gembala (50%) - Bulan ${bulan}`, nominal: gaji };
                    const txTap = { id: generateId() + 'B', tanggal: today, jenis: 'Pengeluaran', kategori: 'Gaji & Honor', rincian: 'TAP Gembala', keterangan: `Pencairan TAP Gembala (5%) - Bulan ${bulan}`, nominal: tap };
                    handleSaveTxFirestore([txGaji, txTap]);
                });
            };

            const toggleModalSafe = (key, state) => setModals(prev => ({ ...prev, [key]: state }));
            const openEditTxModal = (transaction) => { setEditingTx(transaction); toggleModalSafe('txEdit', true); };

            if (!isFirebaseReady) return <div className="h-screen w-full bg-[#FBF9F6] flex items-center justify-center font-serif text-[#0b5e46] font-bold text-xl">Menghubungkan ke Server Firebase...</div>;
            if (!currentUser) return <LoginView onShowAlert={showAlert} />;

            const rolePermissions = {
                'Administrator': ['Dashboard', 'Transaksi', 'Jadwal Pelayanan', 'Data Jemaat', 'Laporan', 'Warta Jemaat', 'Import Warta AI', 'Manajemen Pengguna'],
                'Sekretaris': ['Dashboard', 'Transaksi', 'Jadwal Pelayanan', 'Data Jemaat', 'Laporan', 'Warta Jemaat', 'Import Warta AI', 'Manajemen Pengguna'],
                'Bendahara': ['Dashboard', 'Transaksi', 'Laporan', 'Warta Jemaat', 'Import Warta AI']
            };

            const allowedTabs = rolePermissions[currentUser.role] || ['Dashboard'];
            const safeActiveTab = allowedTabs.includes(activeTab) ? activeTab : 'Dashboard';

            const allNavGroups = [
                { title: 'MENU UTAMA', items: [
                    { id: 'Dashboard', icon: <Icons.Dashboard />, label: 'Dashboard' },
                    { id: 'Transaksi', icon: <Icons.Transaction />, label: 'Transaksi' },
                    { id: 'Jadwal Pelayanan', icon: <Icons.Calendar />, label: 'Jadwal Pelayanan' },
                    { id: 'Data Jemaat', icon: <Icons.Users />, label: 'Data Jemaat' },
                ]},
                { title: 'DOKUMEN & CETAK', items: [
                    { id: 'Laporan', icon: <Icons.Report />, label: 'Laporan' },
                    { id: 'Warta Jemaat', icon: <Icons.News />, label: 'Warta Jemaat' },
                    { id: 'Import Warta AI', icon: <Icons.Upload />, label: 'Import Warta (AI)' },
                ]},
                { title: 'SISTEM', items: [
                    { id: 'Manajemen Pengguna', icon: <Icons.Settings />, label: 'Akses Pengguna (Firebase)' },
                ]}
            ];

            const filteredNavGroups = allNavGroups.map(group => ({ ...group, items: group.items.filter(item => allowedTabs.includes(item.id)) })).filter(group => group.items.length > 0);

            const renderContent = () => {
                switch (safeActiveTab) {
                    case 'Dashboard': return <DashboardView transactions={transactions} jemaatData={jemaatData} jadwalData={jadwalData} onCairkanGaji={handleCairkanGaji} />;
                    case 'Transaksi': return <TransaksiView transactions={transactions} onEditTransaction={openEditTxModal} onDeleteTransaction={(id) => showConfirm('Hapus data transaksi ini secara permanen dari Cloud?', () => handleDeleteTxFirestore(id))} onOpenModal={() => toggleModalSafe('tx', true)} />;
                    case 'Data Jemaat': return <DataJemaatView jemaatData={jemaatData} onCsvUpload={async (e) => {
                        const file = e.target.files[0];
                        if (!file) return;
                        const reader = new FileReader();
                        reader.onload = async (event) => {
                            try {
                                const text = event.target.result;
                                let separator = text.indexOf(';') > -1 ? ';' : (text.indexOf('\t') > -1 ? '\t' : ',');
                                const rows = text.split('\n').filter(row => row.trim() !== '');
                                if (rows.length < 2) throw new Error("CSV Kosong");
                                const headers = rows[0].split(separator).map(h => h.trim().replace(/"/g, '').toLowerCase());
                                const parsedData = rows.slice(1).map((row) => {
                                    const cols = row.split(new RegExp(`${separator}(?=(?:(?:[^"]*"){2})*[^"]*$)`));
                                    let rowObj = {};
                                    headers.forEach((header, index) => { rowObj[header] = cols[index] ? cols[index].replace(/"/g, '').trim() : ''; });
                                    const findVal = (keys) => { const foundKey = Object.keys(rowObj).find(k => keys.some(key => k.includes(key))); return foundKey ? rowObj[foundKey] : ''; };
                                    return {
                                        id: generateId(), nama: findVal(['nama', 'name']), jk: findVal(['jk', 'kelamin', 'gender']),
                                        ttl: findVal(['tempat', 'tanggal', 'lahir', 'ttl']), komisi: findVal(['komisi', 'klasifikasi', 'kategori']),
                                        pekerjaan: findVal(['kerja', 'profesi']), kontak: findVal(['kontak', 'hp', 'wa', 'telp']), status: 'Aktif'
                                    };
                                });
                                const batch = db.batch();
                                parsedData.forEach(item => { const ref = churchCollection('jemaat').doc(item.id); batch.set(ref, { ...item, gerejaId: activeGerejaId }); });
                                await batch.commit();
                                showAlert(`Berhasil mengimpor ${parsedData.length} data jemaat ke Firestore!`, 'info');
                            } catch (e) { showAlert("Gagal membaca atau menyimpan CSV.", 'error'); }
                        };
                        reader.readAsText(file); e.target.value = '';
                    }} onDeleteJemaat={(id) => showConfirm('Hapus data jemaat ini dari Cloud?', () => handleDeleteJemaatFirestore(id))} onOpenModal={() => toggleModalSafe('jemaat', true)} />;
                    case 'Jadwal Pelayanan': return <JadwalPelayananView jadwalData={jadwalData} onDeleteJadwal={(id) => showConfirm('Hapus jadwal pelayanan ini?', () => handleDeleteJadwalFirestore(id))} onOpenModal={() => toggleModalSafe('jadwal', true)} />;
                    case 'Laporan': return <LaporanView transactions={transactions} />;
                    case 'Warta Jemaat': return <WartaJemaatView transactions={transactions} jadwalData={jadwalData} jemaatData={jemaatData} />;
                    case 'Import Warta AI': return <WartaAIImportView transactions={transactions} onImportWarta={handleImportWartaFirestore} onShowAlert={showAlert} currentUser={currentUser} />;
                    case 'Manajemen Pengguna': return <PenggunaView usersData={usersData} currentUser={currentUser} onDeleteUser={(id) => showConfirm('Hapus akun pengguna ini secara permanen?', () => handleDeleteUserFirestore(id))} onOpenModal={() => toggleModalSafe('user', true)} onResetPin={(id) => showConfirm('Reset PIN pengguna ini menjadi 1234?', () => resetUserPin(id))} onUpdateRole={(id, newRole) => showConfirm(`Ubah hak akses pengguna ini menjadi ${newRole}?`, () => handleUpdateUserRole(id, newRole))} />;
                    default: return <DashboardView transactions={transactions} jemaatData={jemaatData} jadwalData={jadwalData} onCairkanGaji={handleCairkanGaji} />;
                }
            };

            return (
                <div className="flex h-screen w-full font-sans">
                    {mobileMenuOpen && <div className="fixed inset-0 bg-black/50 z-40 lg:hidden backdrop-blur-sm print-hidden" onClick={() => setMobileMenuOpen(false)} />}
                    <aside className={`print-hidden fixed inset-y-0 left-0 transform ${mobileMenuOpen ? 'translate-x-0' : '-translate-x-full'} lg:relative lg:translate-x-0 w-72 bg-[#064e3b] text-white flex flex-col transition-transform duration-300 z-50 shadow-2xl`}>
                        <div className="p-6 flex items-center gap-4 bg-[#053e2f] border-b border-[#0b5e46]">
                            <div className="w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-inner overflow-hidden flex-shrink-0">
                                <img src="https://lh3.googleusercontent.com/d/1-OZno7fhoeivluj-8Px8F_HiMe3V03mq" onError={(e) => { e.target.onerror = null; e.target.src = "20220804_013421.jpg"; }} alt="Logo GKIN" className="w-full h-full object-cover" />
                            </div>
                            <div>
                                <div className="text-[10px] font-bold text-emerald-300/80 tracking-widest mb-0.5">CLOUD DATABASE</div>
                                <div className="font-serif font-bold text-xl leading-tight">GKIN Hosiana</div>
                            </div>
                        </div>
                        <nav className="flex-1 overflow-y-auto px-4 py-6 space-y-8">
                            {filteredNavGroups.map((group, gIdx) => (
                                <div key={gIdx} className="space-y-2">
                                    <h4 className="px-3 text-[10px] font-bold text-emerald-200/50 uppercase tracking-widest">{group.title}</h4>
                                    {group.items.map((item) => (
                                        <button key={item.id} onClick={() => { setActiveTab(item.id); setMobileMenuOpen(false); }} className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition-all duration-200 ${safeActiveTab === item.id ? 'bg-[#0b5e46] text-white font-semibold shadow-sm' : 'text-emerald-100/70 hover:bg-[#0b5e46]/50 hover:text-white'}`}>
                                            <span className={safeActiveTab === item.id ? 'text-emerald-300' : 'text-emerald-500/70'}>{item.icon}</span>{item.label}
                                        </button>
                                    ))}
                                </div>
                            ))}
                        </nav>
                        <div className="p-4 bg-[#053e2f] border-t border-[#0b5e46]">
                            <button onClick={() => showConfirm('Anda yakin ingin keluar (Logout)?', () => auth.signOut())} className="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-red-500/20 text-red-200 hover:bg-red-500 hover:text-white rounded-lg text-sm font-medium transition-colors">
                                <Icons.LogOut /> Keluar Aplikasi
                            </button>
                        </div>
                    </aside>
                    <div className="flex-1 flex flex-col h-screen overflow-hidden relative bg-[#FBF9F6]">
                        <header className="print-hidden border-b border-gray-200/50 px-6 py-4 flex justify-between items-center shadow-sm z-10 sticky top-0 bg-[#FBF9F6]">
                            <div className="flex items-center gap-4">
                                <button className="lg:hidden p-2 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors" onClick={() => setMobileMenuOpen(!mobileMenuOpen)}><Icons.Menu /></button>
                                <h1 className="text-xl font-serif font-bold text-[#064e3b]">{safeActiveTab}</h1>
                            </div>
                            <div className="flex items-center gap-3">
                                <div className="text-right mr-2">
                                    <p className="text-sm font-bold text-gray-800 leading-none capitalize">{currentUser.nama}</p>
                                    <p className="text-xs text-emerald-600 font-semibold mt-1">{currentUser.role} · {currentUser.loginId || ''}</p>
                                    <button onClick={() => changeOwnPin(false)} className="text-[10px] font-bold text-emerald-700 hover:underline mt-1">Ganti PIN</button>
                                </div>
                                <div className="w-10 h-10 rounded-full bg-[#0b5e46] flex items-center justify-center text-white font-bold text-lg shadow-sm border-2 border-[#f0c868]">
                                    {(currentUser.nama || 'U').charAt(0).toUpperCase()}
                                </div>
                            </div>
                        </header>
                        
                        <main className="flex-1 overflow-y-auto p-4 md:p-8 relative">
                            <div className="max-w-[98%] w-full mx-auto pb-12">
                                {renderContent()}
                            </div>
                        </main>
                    </div>

                    <AlertDialog isOpen={alertState.show} message={alertState.message} type={alertState.type} onClose={() => setAlertState(prev => ({ ...prev, show: false }))} />
                    <ConfirmDialog isOpen={confirmState.show} message={confirmState.message} onConfirm={confirmState.onConfirm} onClose={() => setConfirmState(prev => ({ ...prev, show: false }))} />

                    <ModalTransaksi isOpen={modals.tx} onClose={() => toggleModalSafe('tx', false)} onShowAlert={showAlert} onSave={handleSaveTxFirestore} />
                    <ModalEditTransaksi isOpen={modals.txEdit} onClose={() => { toggleModalSafe('txEdit', false); setEditingTx(null); }} onSave={handleUpdateTxFirestore} transaction={editingTx} onShowAlert={showAlert} />
                    <ModalJemaat isOpen={modals.jemaat} onClose={() => toggleModalSafe('jemaat', false)} onSave={handleSaveJemaatFirestore} />
                    <ModalJadwal isOpen={modals.jadwal} onClose={() => toggleModalSafe('jadwal', false)} onSave={handleSaveJadwalFirestore} />
                    <ModalPengguna isOpen={modals.user} onClose={() => toggleModalSafe('user', false)} onShowAlert={showAlert} onSave={(data) => showAlert("Akun Staf berhasil ditambahkan di Firebase!", "info")} />
                </div>
            );
        };
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
