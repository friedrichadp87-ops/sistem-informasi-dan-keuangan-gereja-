    <script type="text/babel">
        // ==========================================
        // 1. FIREBASE CONFIGURATION
        // ==========================================
        // Konfigurasi Firebase bersama dengan WebPresenter Pro.
        // Kedua website tetap terpisah, tetapi menggunakan proyek Firebase yang sama.
        const firebaseConfig = {
            apiKey: "AIzaSyCGONFq9cQ52jwh8mk7CMjN4DiIAJngd1s",
            authDomain: "webpresenter-pro.firebaseapp.com",
            databaseURL: "https://webpresenter-pro-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "webpresenter-pro",
            storageBucket: "webpresenter-pro.firebasestorage.app",
            messagingSenderId: "1007932693025",
            appId: "1:1007932693025:web:c81eee4803e05fa8fc6160",
            measurementId: "G-Q6MFEPD8B3"
        };

        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }
        const auth = firebase.auth();
        const db = firebase.firestore();
        const pinChangePrompted = new Set();

        // Tenant scope GKINHUB: seluruh data operasional berada di subkoleksi gereja.
        // Nilai ini hanya diisi setelah profil pengguna tervalidasi dari Firestore.
        let activeGerejaId = null;
        // Penanda agar listener Auth tidak membaca profil sebelum alur login Google
        // selesai membuat/memeriksa profil GKINHUB.
        let accountLoginFlowActive = false;
        const churchCollection = (name) => {
            if (!activeGerejaId) throw new Error('Profil gereja belum tersedia. Silakan masuk kembali.');
            return db.collection('churches').doc(activeGerejaId).collection(name);
        };

        let secondaryApp;
        let secondaryDb;
        try {
            secondaryApp = firebase.initializeApp(firebaseConfig, "Secondary");
            secondaryDb = secondaryApp.firestore();
        } catch (e) {
            secondaryApp = firebase.app("Secondary");
            secondaryDb = secondaryApp.firestore();
        }
        // Firebase Spark: pengelolaan staf dilakukan langsung melalui Firebase Auth + Firestore,
        // tanpa Cloud Functions. PIN staf dikonversi menjadi password Firebase yang valid.
        // Catatan: PIN 4 digit tetap memiliki entropi rendah; wajib diganti saat login pertama.
        const secondaryAuth = secondaryApp.auth();
        const staffAuthPassword = (pin) => 'GKINHUB#' + String(pin);
        const staffEmailFromId = (loginId) => String(loginId).trim().toLowerCase() + '@staff.webpresenter-pro.firebaseapp.com';
        const staffIndexRef = (loginId) => db.collection('staffLoginIndex').doc(String(loginId).trim().toUpperCase());
        const createStaffLoginId = (role) => {
            const prefix = role === 'Sekretaris' ? 'SKRT' : role === 'Bendahara' ? 'BNDH' : role === 'Administrator' ? 'ADM' : 'STF';
            return prefix + String(Math.floor(10000000 + Math.random() * 90000000));
        };

        // Profil GKINHUB terpisah dari profil WebPresenter Pro (RTDB), tetapi UID Firebase Auth sama.
        // Pengguna lama dari WebPresenter dapat memakai Google atau email/password sesuai provider asal.
        // Saat pertama kali masuk GKINHUB, akun yang belum memiliki profil harus menginisialisasi gerejanya.
        const ensureGkinhubChurchProfile = async (user, providerId) => {
            if (!user || !user.uid) throw new Error('Firebase tidak mengembalikan identitas pengguna.');
            const userRef = db.collection('users').doc(user.uid);
            const existing = await userRef.get();
            if (existing.exists) {
                const profile = existing.data() || {};
                if (!profile.gerejaId) throw new Error('PROFILE_MISSING_CHURCH');
                return profile;
            }

            const churchName = window.prompt(
                'Akun berhasil masuk ke Firebase WebPresenter Pro. Untuk mulai menggunakan GKINHUB, masukkan nama gereja. Jika Anda akan bergabung ke gereja yang sudah terdaftar, tekan Batal dan minta Administrator gereja mengundang/mendaftarkan akun Anda.'
            );
            if (!churchName || !churchName.trim()) {
                const cancelled = new Error('PROFILE_SETUP_CANCELLED');
                cancelled.code = 'gkinhub/profile-setup-cancelled';
                try { await auth.signOut(); } catch (_) {}
                throw cancelled;
            }

            const secretaryName = window.prompt('Nama lengkap Sekretaris / Administrator:', user.displayName || 'Sekretaris') || user.displayName || 'Sekretaris';
            const gerejaId = 'GKR-' + user.uid.slice(0, 10).toUpperCase();
            const batch = db.batch();
            batch.set(db.collection('churches').doc(gerejaId), {
                gerejaId,
                namaGereja: churchName.trim(),
                ownerUid: user.uid,
                status: 'Aktif',
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            });
            batch.set(userRef, {
                id: user.uid,
                uid: user.uid,
                email: user.email || '',
                nama: secretaryName.trim(),
                gerejaId,
                role: 'Administrator',
                jabatan: 'Sekretaris',
                status: 'Aktif',
                provider: providerId || 'firebase',
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            });
            await batch.commit();
            const profileSnap = await userRef.get();
            if (!profileSnap.exists) throw new Error('PROFILE_NOT_CREATED');
            return profileSnap.data() || {};
        };

        const { useState, useEffect, useMemo } = React;

        // ==========================================
        // UTILITIES
        // ==========================================
        const formatRp = (angka) => new Intl.NumberFormat('id-ID', { minimumFractionDigits: 0 }).format(angka || 0);
        const formatRpFull = (angka) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka || 0);
        const generateId = () => Math.random().toString(36).substr(2, 9);
        const formatTanggalFull = (dateString) => {
            if(!dateString) return '';
            const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            const d = new Date(dateString);
            return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
        };
        const formatHariTanggal = (dateString) => {
            if(!dateString) return '';
            const days = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
            const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            const d = new Date(dateString);
            return `${days[d.getDay()]}, ${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
        };
        const formatTanggalPendek = (dateString) => {
            if(!dateString) return '';
            const d = new Date(dateString);
            return `${d.getDate()}/${d.getMonth()+1}/${d.getFullYear()}`;
        };
        const formatTanggalBulan = (dateString) => {
            if(!dateString) return '';
            const d = new Date(dateString);
            return `${d.getDate()}/${d.getMonth()+1}`;
        };
        const formatBulanTahun = (dateString) => {
            if(!dateString) return '';
            const months = ['JANUARI', 'FEBRUARI', 'MARET', 'APRIL', 'MEI', 'JUNI', 'JULI', 'AGUSTUS', 'SEPTEMBER', 'OKTOBER', 'NOVEMBER', 'DESEMBER'];
            const d = new Date(dateString);
            return `${months[d.getMonth()]} ${d.getFullYear()}`;
        };

        const getLocalYYYYMMDD = (d) => {
            const yyyy = d.getFullYear();
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            return `${yyyy}-${mm}-${dd}`;
        };

        // ==========================================
        // ICONS COLLECTION
        // ==========================================
        const Icons = {
