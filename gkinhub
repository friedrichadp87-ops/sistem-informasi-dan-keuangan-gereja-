                            <div className="mt-7 pt-6 border-t border-gray-100 text-center">
                                <p className="text-sm text-gray-500">{isRegistering ? 'Sudah memiliki akun?' : 'Belum memiliki akun?'} <button type="button" onClick={() => setIsRegistering(!isRegistering)} className="text-[#087052] font-bold hover:underline">{isRegistering ? 'Kembali ke login' : 'Daftar akun'}</button></p>
