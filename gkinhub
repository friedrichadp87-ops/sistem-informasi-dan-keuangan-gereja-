        /* --------------------------------------------------------
           SISTEM CETAK (PRINT CSS) YANG DISEMPURNAKAN
           -------------------------------------------------------- */
        @media print {
            /* 1. Paksa browser menampilkan seluruh halaman yang overflow (Solusi Bawah Terpotong) */
            body, html { 
                overflow: visible !important; 
                height: auto !important; 
                background-color: white !important; 
            }
            
            /* Lepaskan semua kunci layar (height: 100vh) bawaan Tailwind */
            #root, .h-screen, .flex-1, .overflow-hidden, .overflow-y-auto, .overflow-x-auto {
                height: auto !important;
                overflow: visible !important;
                display: block !important;
                position: static !important;
            }

            /* 2. Sembunyikan elemen web yang tidak perlu dicetak */
            aside, header, .print-hidden { 
                display: none !important; 
            }
            
            /* 3. Aturan Kertas Presisi & Simetris (Solusi margin miring) */
            @page {
                size: A4 portrait;
                /* Memaksa margin simetris 1.5cm di setiap sisi kertas A4 */
                margin: 15mm auto !important; 
            }

            /* 4. Penyesuaian Area Kertas */
            .print-area { 
                position: relative !important; 
                width: 100% !important; 
                max-width: none !important; 
                margin: 0 !important; 
                padding: 0 !important; 
                box-shadow: none !important; 
                border: none !important; 
            }
            
            /* 5. Styling Tabel Cetak (Klasik Hitam Putih + Kuning) */
            .print-table { border-collapse: collapse; width: 100% !important; font-size: 11px; color: black; }
            .print-table th, .print-table td { border: 1px solid black; padding: 5px; text-align: center; word-wrap: break-word; }
            .print-table th { font-weight: bold; }
            
            /* Warna Kuning Stabilo untuk Cetak */
            .bg-kuning { background-color: #FFFF00 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; color: black; }
            
            /* 6. Mencegah Tabel / Teks Terpotong Berantakan di Batas Kertas */
            table { page-break-inside: auto; }
            tr { page-break-inside: avoid; page-break-after: auto; }
            thead { display: table-header-group; }
            tfoot { display: table-footer-group; }
            section { page-break-inside: avoid; }
            h2, h3 { page-break-after: avoid; }
            
            /* 7. Styling Khusus Text Warta */
            .warta-title { font-family: 'Playfair Display', serif; font-weight: 800; font-size: 24px; text-align: center; text-transform: uppercase; margin-bottom: 4px; color: black;}
