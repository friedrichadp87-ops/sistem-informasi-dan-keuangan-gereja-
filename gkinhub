                } finally {
                    accountLoginFlowActive = false;
                    setIsLoading(false);
                }
            };

            const handleSubmit = async (e) => {
                e.preventDefault();
                if (isLoading) return;
                setIsLoading(true);
                const identityInput = (isRegistering ? ((e.target.emailDaftar && e.target.emailDaftar.value) || '') : e.target.identitas.value).trim();
                const password = String(e.target.password.value || '');

                try {
                    if (isRegistering) {
                        const churchName = String(e.target.namaGereja.value || '').trim();
                        const secretaryName = String(e.target.nama.value || '').trim();
                        const treasurerName = String(e.target.namaBendahara.value || '').trim() || 'Bendahara';
                        const registrationEmail = identityInput.toLowerCase();
                        if (!churchName || !secretaryName || !registrationEmail.includes('@')) {
                            throw new Error('Lengkapi nama gereja, nama Sekretaris, dan email yang valid.');
                        }
                        const userCredential = await secondaryAuth.createUserWithEmailAndPassword(registrationEmail, password);
                        const uid = userCredential.user.uid;
                        const gerejaId = 'GKR-' + uid.slice(0, 10).toUpperCase();
                        const batch = secondaryDb.batch();
                        batch.set(secondaryDb.collection('churches').doc(gerejaId), {
                            gerejaId, namaGereja: churchName, ownerUid: uid, status: 'Aktif',
                            createdAt: firebase.firestore.FieldValue.serverTimestamp()
                        });
                        batch.set(secondaryDb.collection('users').doc(uid), {
                            id: uid, uid, email: registrationEmail, nama: secretaryName,
                            gerejaId, role: 'Administrator', jabatan: 'Sekretaris', status: 'Aktif',
                            provider: 'password', createdAt: firebase.firestore.FieldValue.serverTimestamp()
                        });
                        await batch.commit();
                        await secondaryAuth.signOut();
                        setIsRegistering(false);
                        e.target.reset();
                        onShowAlert('Pendaftaran gereja berhasil. Login Administrator menggunakan email dan password yang didaftarkan. Tambahkan Bendahara/Sekretaris melalui menu Manajemen Pengguna.', 'info');
                        setIsLoading(false);
                        return;
                    }

                    accountLoginFlowActive = true;
                    if (identityInput.includes('@')) {
                        // Email/password hanya untuk akun Firebase yang memang memiliki provider password.
                        const credential = await auth.signInWithEmailAndPassword(identityInput.toLowerCase(), password);
                        await ensureGkinhubChurchProfile(credential.user, 'password');
                    } else {
                        // ID staf dipetakan ke email Firebase melalui dokumen indeks publik berisi data minimum.
                        const loginId = identityInput.toUpperCase();
                        const indexSnap = await staffIndexRef(loginId).get();
                        if (!indexSnap.exists) throw Object.assign(new Error('ID Pengguna tidak ditemukan.'), { code: 'staff/id-not-found' });
                        const indexData = indexSnap.data() || {};
                        if (indexData.status !== 'Aktif' || !indexData.email || !indexData.uid) {
                            throw Object.assign(new Error('Akun staf tidak aktif. Hubungi Administrator gereja.'), { code: 'staff/account-disabled' });
                        }
                        const credential = await auth.signInWithEmailAndPassword(indexData.email, staffAuthPassword(password));
                        const profileSnap = await db.collection('users').doc(credential.user.uid).get();
                        if (!profileSnap.exists) {
                            await auth.signOut();
                            throw new Error('Profil staf tidak ditemukan. Hubungi Administrator gereja.');
                        }
                        const profile = profileSnap.data() || {};
                        if (credential.user.uid !== indexData.uid || profile.gerejaId !== indexData.gerejaId || profile.loginId !== loginId || profile.status !== 'Aktif') {
                            await auth.signOut();
                            throw new Error('Data akun tidak cocok atau akun sudah dinonaktifkan. Hubungi Administrator gereja.');
                        }
                    }
                } catch (error) {
                    if (error.code === 'gkinhub/profile-setup-cancelled') {
                        setIsLoading(false);
                        return;
                    }
                    console.error('Login GKIN HUB gagal:', error.code, error);
                    const messages = {
                        'auth/invalid-credential': 'Email atau password tidak cocok. Jika akun dibuat dengan Google, gunakan tombol Masuk dengan Google. Untuk akun ID, masukkan ID dan PIN.',
                        'auth/wrong-password': 'Password tidak sesuai. Jika akun dibuat dengan Google, gunakan tombol Masuk dengan Google.',
                        'auth/user-not-found': 'Akun dengan email tersebut belum terdaftar di Firebase Authentication.',
                        'auth/invalid-email': 'Format email atau ID Pengguna tidak valid.',
                        'auth/too-many-requests': 'Terlalu banyak percobaan. Silakan coba kembali beberapa saat lagi.',
                        'functions/unauthenticated': 'ID Pengguna atau PIN salah.',
                        'functions/resource-exhausted': 'Terlalu banyak percobaan. Coba kembali setelah 15 menit.',
                        'functions/not-found': 'ID Pengguna tidak ditemukan atau backend login GKINHUB belum dideploy.',
                        'functions/failed-precondition': 'Akun belum siap digunakan. Hubungi Administrator gereja.',
                        'functions/permission-denied': 'Akun tidak memiliki hak untuk melakukan tindakan ini.',
                        'functions/internal': 'Backend GKINHUB mengalami kesalahan. Periksa log Cloud Functions.',
                        'staff/id-not-found': 'ID Pengguna tidak ditemukan. Periksa kembali ID yang dimasukkan.',
                        'staff/account-disabled': 'Akun staf tidak aktif. Hubungi Administrator gereja.'
                    };
                    onShowAlert(messages[error.code] || error.message || 'Login gagal. Periksa kembali ID/email dan PIN/password.', 'error');
                } finally {
                    accountLoginFlowActive = false;
                    setIsLoading(false);
                }
            };

            return (
                <main className="min-h-screen w-full flex items-center justify-center px-4 py-8 relative overflow-y-auto bg-[#f3f7f5]">
                    <div className="absolute inset-0 pointer-events-none" style={{backgroundImage:'radial-gradient(#0b5e46 0.8px, transparent 0.8px)',backgroundSize:'24px 24px',opacity:.12}}></div>
                    <div className="absolute -top-36 -right-28 w-96 h-96 rounded-full bg-emerald-100 blur-3xl opacity-70 pointer-events-none"></div>
                    <div className="absolute -bottom-40 -left-24 w-96 h-96 rounded-full bg-teal-100 blur-3xl opacity-70 pointer-events-none"></div>

                    <section className="relative z-10 w-full max-w-5xl bg-white rounded-[28px] shadow-2xl shadow-emerald-950/10 overflow-hidden grid md:grid-cols-2 border border-white animate-fade-in">
                        <div className="hidden md:flex flex-col justify-between p-10 lg:p-12 text-white bg-gradient-to-br from-[#064e3b] via-[#087052] to-[#0d8060] relative overflow-hidden">
                            <div className="absolute -right-24 -top-20 w-80 h-80 border border-white/10 rounded-full"></div>
                            <div className="absolute -right-10 -top-6 w-52 h-52 border border-white/10 rounded-full"></div>
                            <div className="absolute -left-20 -bottom-24 w-80 h-80 rounded-full bg-white/5"></div>
                            <div className="relative">
                                <div className="w-14 h-14 rounded-2xl bg-white/15 border border-white/20 flex items-center justify-center text-2xl font-extrabold tracking-tight">GH</div>
                                <p className="mt-8 text-xs font-bold tracking-[.28em] text-emerald-100 uppercase">Portal Pelayanan Gereja</p>
                                <h2 className="mt-4 text-4xl lg:text-5xl font-bold leading-tight">Kelola gereja,<br/>lebih mudah<br/>dan teratur.</h2>
                                <p className="mt-5 text-sm leading-7 text-emerald-50/85 max-w-sm">Satu ruang kerja untuk membantu pengelolaan administrasi, pelayanan, warta jemaat, dan keuangan gereja.</p>
                            </div>
                            <div className="relative flex items-center gap-3 text-xs text-emerald-100/80">
                                <span className="w-2 h-2 rounded-full bg-emerald-300"></span>
                                <span>Terintegrasi • Praktis • Terorganisasi</span>
                            </div>
                        </div>

                        <div className="p-7 sm:p-10 lg:p-12 flex flex-col justify-center">
                            <div className="md:hidden flex justify-center mb-6">
                                <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#064e3b] to-[#0d8060] text-white flex items-center justify-center text-xl font-extrabold shadow-lg">GH</div>
                            </div>
                            <div className="mb-8">
                                <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 text-[#087052] text-[10px] font-bold tracking-[.16em] uppercase mb-4">
                                    <span className="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Portal Gereja
                                </div>
                                <h1 className="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#064e3b]">GKIN HUB</h1>
                                <p className="text-sm text-gray-500 mt-2">Sistem Informasi Database Gereja</p>
                                <p className="text-sm text-gray-400 mt-5">{isRegistering ? 'Buat akun untuk mulai menggunakan layanan.' : 'Selamat datang kembali. Silakan masuk ke akun Anda.'}</p>
                                {!isRegistering && <p className="text-xs leading-5 text-gray-500 mt-3">Masuk menggunakan ID Pengguna dan PIN GKINHUB, atau gunakan email/password akun WebPresenter Pro. Akun Google masuk melalui tombol Google.</p>}
                            </div>

                            <form onSubmit={handleSubmit} className="space-y-5">
                                {isRegistering ? (
                                    <div className="space-y-5">
                                    <div>
                                        <label className="block text-xs font-bold text-gray-700 mb-2">NAMA GEREJA</label>
                                        <input type="text" name="namaGereja" required className="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl text-sm" placeholder="Nama gereja" />
                                    </div>
                                    <div>
                                        <label className="block text-xs font-bold text-gray-700 mb-2">NAMA LENGKAP SEKRETARIS</label>
                                        <input type="text" name="nama" required autoComplete="name" className="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl text-sm" placeholder="Nama sekretaris" />
