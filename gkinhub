        };

        // ==========================================
        // MODULE VIEWS
        // ==========================================
        const DashboardView = ({ transactions, jemaatData, jadwalData, onCairkanGaji }) => {
            const pemasukanKas = transactions.filter(t => t.jenis === 'Pemasukan' && !t.rincian.includes('(Emeritus)') && !t.rincian.includes('(Gerakan 1000)')).reduce((sum, t) => sum + t.nominal, 0);
            const pengeluaran = transactions.filter(t => t.jenis === 'Pengeluaran').reduce((sum, t) => sum + t.nominal, 0);
            const saldoKasUtama = pemasukanKas - pengeluaran;

            const totalEmeritus = transactions.filter(t => t.jenis === 'Pemasukan' && t.rincian.includes('(Emeritus)')).reduce((sum, t) => sum + t.nominal, 0);
            const totalGerakan1000 = transactions.filter(t => t.jenis === 'Pemasukan' && t.rincian.includes('(Gerakan 1000)')).reduce((sum, t) => sum + t.nominal, 0);

            const currentMonth = new Date().toISOString().slice(0, 7); 
            const pemasukanBulanIni = transactions.filter(t => t.jenis === 'Pemasukan' && t.tanggal.startsWith(currentMonth) && !t.rincian.includes('(Emeritus)') && !t.rincian.includes('(Gerakan 1000)')).reduce((sum, t) => sum + t.nominal, 0);

            const estimasiGaji = pemasukanBulanIni * 0.50; 
            const estimasiTap = pemasukanBulanIni * 0.05;  

            const today = new Date().toISOString().split('T')[0];
            const upcomingJadwal = jadwalData.filter(j => j.tanggal >= today).sort((a,b) => a.tanggal.localeCompare(b.tanggal)).slice(0,3);

            return (
                <div className="space-y-6 animate-fade-in">
