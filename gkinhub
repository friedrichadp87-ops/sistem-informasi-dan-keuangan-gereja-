            .list-content p { display: flex; margin-bottom: 6px; }
            .list-content p span:first-child { min-width: 15px; font-weight: bold; }
        }

        /* --------------------------------------------------------
           STYLING TAMPILAN WEB (AGAR MIRIP PDF)
