            const [apiKeyStatusText, setApiKeyStatusText] = useState('Memeriksa konfigurasi API key…');
            const [pdfFile, setPdfFile] = useState(null);
            const [parsed, setParsed] = useState(null);
            const [rawJson, setRawJson] = useState('');
            const [busy, setBusy] = useState(false);
            const [saving, setSaving] = useState(false);
            const [errorText, setErrorText] = useState('');
            const [reviewed, setReviewed] = useState(false);
            const [confirmSendToGemini, setConfirmSendToGemini] = useState(false);
            const [savedReports, setSavedReports] = useState([]);
            const [historyError, setHistoryError] = useState('');

            useEffect(() => {
                const unsubscribe = churchCollection('wartaImports').orderBy('reportMonth', 'desc').limit(12).onSnapshot(snapshot => {
                    setSavedReports(snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })));
                    setHistoryError('');
                }, err => {
                    console.warn('Riwayat import warta belum bisa dibaca:', err);
                    setHistoryError('Riwayat impor belum dapat dibaca. Pastikan aturan Firestore untuk koleksi wartaImports sudah ditambahkan.');
                });
                return () => unsubscribe();
            }, []);

            // Mode sederhana untuk pemakaian internal: API key disimpan langsung di Firestore.
            // Browser yang berhak mengakses dokumen ini dapat melihat key lewat Developer Tools.
            const geminiKeyRef = () => churchCollection('systemSettings').doc('geminiApiKey');
            const canUseWartaAI = (user) => !!user && user.status === 'Aktif' && ['Administrator', 'Sekretaris', 'Bendahara'].includes(String(user.role || ''));

            const refreshGeminiKeyStatus = async () => {
                try {
                    if (!currentUser) throw new Error('Silakan login kembali ke Database Gereja.');
                    if (!canUseWartaAI(currentUser)) throw new Error('Akses Import Warta AI hanya untuk akun aktif Administrator, Sekretaris, atau Bendahara.');
                    const snap = await geminiKeyRef().get();
                    const data = snap.exists ? snap.data() : {};
                    const configured = !!(data && typeof data.apiKey === 'string' && data.apiKey.trim());
                    setApiKeyConfigured(configured);
                    let updatedText = '';
                    if (data && data.updatedAt && typeof data.updatedAt.toDate === 'function') {
                        updatedText = ' · diperbarui ' + data.updatedAt.toDate().toLocaleString('id-ID');
                    }
                    setApiKeyStatusText(configured
                        ? 'API key sudah tersimpan di Firestore.' + updatedText
                        : 'API key belum disimpan. Administrator dapat menyimpannya di bawah.');
                } catch (err) {
                    setApiKeyConfigured(null);
                    const msg = String((err && err.message) || 'Status API key belum dapat diperiksa.');
                    setApiKeyStatusText(msg.indexOf('permission') >= 0 || msg.indexOf('Missing or insufficient') >= 0
                        ? 'Akses ditolak Firestore. Tambahkan aturan khusus systemSettings/geminiApiKey untuk staf aktif, dan hanya izinkan Administrator menulis key.'
                        : msg);
                }
            };

            useEffect(() => {
                refreshGeminiKeyStatus();
            }, [currentUser ? currentUser.uid : '']);

            const saveGeminiKeyToFirestore = async () => {
                if (!currentUser || currentUser.role !== 'Administrator' || currentUser.status !== 'Aktif') {
                    setApiKeyStatusText('Hanya Administrator aktif yang dapat menyimpan atau mengganti API key.');
                    return;
                }
                const key = String(apiKeyInput || '').trim();
                if (key.length < 20 || key.length > 500 || /\s/.test(key)) {
                    setApiKeyStatusText('API key kosong atau formatnya tidak valid. Tempelkan key tanpa spasi.');
                    return;
                }
                setSavingApiKey(true);
                setApiKeyStatusText('Menyimpan API key langsung ke Firestore…');
                try {
                    await geminiKeyRef().set({
                        gerejaId: activeGerejaId,
                        apiKey: key,
                        updatedAt: firebase.firestore.FieldValue.serverTimestamp(),
                        updatedBy: currentUser.uid,
                        updatedByName: String(currentUser.nama || currentUser.email || 'Administrator')
                    }, { merge: true });
                    setApiKeyInput('');
                    setApiKeyConfigured(true);
                    setApiKeyStatusText('API key berhasil disimpan ke Firestore. Browser tidak akan menampilkan kembali isi kolom key.');
                } catch (err) {
                    const msg = String((err && err.message) || 'Gagal menyimpan API key.');
                    setApiKeyStatusText(msg.indexOf('permission') >= 0 || msg.indexOf('Missing or insufficient') >= 0
                        ? 'Firestore menolak penyimpanan. Periksa aturan systemSettings/geminiApiKey: hanya Administrator aktif yang boleh menulis.'
                        : msg);
                } finally {
                    setSavingApiKey(false);
                }
            };

            const fmt = (n) => formatRpFull(Number(n) || 0);
            const totalDetail = parsed ? (parsed.serviceEntries || []).reduce((s, x) => s + (Number(x.amount) || 0), 0) : 0;
            const totalExpenses = parsed ? (parsed.expenseEntries || []).reduce((s, x) => s + (Number(x.amount) || 0), 0) : 0;
            const existingPeriod = (parsed && parsed.reportMonth) ? parsed.reportMonth : '';
            const maybeDuplicates = parsed ? (parsed.serviceEntries || []).filter(x => transactions.some(t => t.jenis === 'Pemasukan' && t.tanggal === x.date && Number(t.nominal) === Number(x.amount) && String(t.rincian || '').toLowerCase().includes(String(x.service || '').toLowerCase()))).length : 0;

            const base64FromArrayBuffer = (buffer) => {
                const bytes = new Uint8Array(buffer);
                const chunkSize = 0x8000;
                let binary = '';
                for (let i = 0; i < bytes.length; i += chunkSize) {
                    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));
                }
                return btoa(binary);
            };

            const parseGeminiJson = (text) => {
                const cleaned = String(text || '').trim()
                    .replace(/^```(?:json)?\s*/i, '')
                    .replace(/\s*```\s*$/i, '');
                const start = cleaned.indexOf('{');
                const end = cleaned.lastIndexOf('}');
                if (start < 0 || end <= start) throw new Error('AI tidak mengembalikan JSON yang dapat dibaca. Coba ulangi atau ganti model.');
                const data = JSON.parse(cleaned.slice(start, end + 1));
                if (!/^\d{4}-\d{2}$/.test(String(data.reportMonth || ''))) throw new Error('Periode laporan belum berhasil dibaca dalam format YYYY-MM. Periksa PDF atau koreksi hasil JSON.');
                data.serviceEntries = Array.isArray(data.serviceEntries) ? data.serviceEntries.filter(x => Number(x.amount) > 0).map(x => ({
                    date: String(x.date || ''), service: String(x.service || 'Ibadah tidak teridentifikasi'), attendance: Number(x.attendance) || 0,
                    channel: String(x.channel || 'Lain-lain'), amount: Math.round(Number(x.amount) || 0)
                })) : [];
                data.expenseEntries = Array.isArray(data.expenseEntries) ? data.expenseEntries.filter(x => Number(x.amount) > 0).map(x => ({
                    description: String(x.description || 'Pengeluaran tidak teridentifikasi'), amount: Math.round(Number(x.amount) || 0)
                })) : [];
                data.summaryIncome = Array.isArray(data.summaryIncome) ? data.summaryIncome.map(x => ({ label: String(x.label || ''), amount: Math.round(Number(x.amount) || 0) })) : [];
                data.notes = data.notes && typeof data.notes === 'object' ? data.notes : { syukur: '', perpuluhan: '', lainLain: '' };
                data.warnings = Array.isArray(data.warnings) ? data.warnings.map(x => String(x)) : [];
                return data;
            };

            // Pemanggilan Gemini langsung dari browser menggunakan key di Firestore.
            // Sesuai keputusan pemilik sistem untuk pemakaian internal; key dapat terlihat oleh pengguna
            // yang berhak membaca dokumen Firestore dan melalui Developer Tools.
            const WARTA_PROMPT = `Anda adalah asisten ekstraksi akuntansi gereja. Baca PDF yang dilampirkan dan ambil HANYA bagian "3) WARTA KEUANGAN BULAN ...": subbagian 1 sampai 5 berupa rincian persembahan per ibadah/per tanggal; subbagian 7 berupa ringkasan pemasukan, daftar pengeluaran, total dan defisit; serta CATATAN tepat di bawah subbagian 7 tentang Persembahan Syukur, Perpuluhan, dan Persembahan Lain-lain. JANGAN mengambil bagian 8 Persembahan Sukarela atau bagian lain di luar itu.

Kembalikan JSON valid saja dengan struktur: {
"sourceBulletinMonth":"YYYY-MM bulan warta utama jika terbaca",
"reportMonth":"YYYY-MM periode laporan keuangan pada judul bagian 7",
"serviceEntries":[{"date":"YYYY-MM-DD","service":"nama ibadah","attendance":0,"channel":"Kantong|Perpuluhan|Syukur|QRIS|Lain-lain|Emeritus|Gerakan 1000","amount":0}],
"summaryIncome":[{"label":"label persis dari ringkasan nomor 7 sisi pemasukan","amount":0}],
"expenseEntries":[{"description":"uraian pengeluaran persis seperti warta","amount":0}],
"reportedTotalIncome":0,"reportedTotalExpenses":0,"reportedDeficit":0,
"notes":{"syukur":"isi catatan persembahan syukur, tulis 'Kosong pada warta' bila kosong","perpuluhan":"isi seluruh catatan perpuluhan, nama dan nominal bila disebut","lainLain":"isi seluruh catatan persembahan lain-lain, nama dan nominal bila disebut"},
"warnings":["catatan ambiguitas atau bagian tidak terbaca"]}

Aturan wajib:
- Periode diambil dari judul nomor 7, bukan otomatis dari bulan nama file. Untuk tanggal pada subbagian 1-5, gabungkan nomor tanggal dengan reportMonth.
- Masukkan setiap nilai positif per tanggal dan kanal; jangan masukkan baris total tabel sebagai transaksi. Kolom kosong atau tanda '-' berarti nol dan tidak perlu menjadi entry.
- Catatan nama pemberi di bawah laporan adalah rincian/anotasi dari jumlah yang sudah direkap, bukan pemasukan baru; jangan tambahkan ke serviceEntries atau expenseEntries.
- Ringkasan pemasukan nomor 7 hanya pembanding, jangan memasukkannya sebagai transaksi tambahan. Baris pengeluaran nomor 7 masuk satu kali per uraian.
- Nominal angka Indonesia seperti 1.167.000 harus menjadi integer 1167000 Rupiah. Jangan mengarang nominal yang tidak tercantum.
- Item seperti "Defisit Agustus" tetap dicatat sebagai pengeluaran jika tercantum di daftar pengeluaran.
- Jangan membaca bagian lain di luar yang diminta. Jika data tidak jelas, tuliskan di warnings dan jangan menebak.`;

            const getGeminiApiKeyFromFirestore = async () => {
                if (!currentUser) throw new Error('Sesi login berakhir. Silakan login kembali.');
                if (!canUseWartaAI(currentUser)) throw new Error('Akun harus aktif dan memiliki peran Administrator, Sekretaris, atau Bendahara.');
                const snap = await geminiKeyRef().get();
                const data = snap.exists ? snap.data() : null;
                const key = data && typeof data.apiKey === 'string' ? data.apiKey.trim() : '';
                if (!key) throw new Error('API key belum tersimpan. Tempel key lalu klik Simpan API key ke Firestore.');
                return key;
            };

            // Ambil daftar model yang benar-benar tersedia untuk API key/proyek ini.
            // Ini mencegah fallback ke nama model lama yang sekarang mungkin sudah tidak tersedia.
            const daftarModelGeminiTersedia = async (apiKey) => {
                let response;
                let body;
                try {
                    response = await fetch('https://generativelanguage.googleapis.com/v1beta/models?pageSize=100', {
                        method: 'GET',
                        headers: { 'x-goog-api-key': apiKey }
                    });
                    body = await response.json();
                } catch (err) {
                    throw new Error('Tidak dapat mengambil daftar model Gemini. Periksa koneksi internet atau izin API key, lalu coba lagi.');
                }
                if (!response.ok || (body && body.error)) {
                    const code = Number((body && body.error && body.error.code) || response.status || 0);
                    const message = body && body.error && body.error.message ? body.error.message : 'Daftar model tidak dapat dimuat.';
                    if (code === 401 || code === 403) throw new Error('API key Gemini tidak valid atau tidak memiliki izin untuk membaca daftar model (' + code + '). Periksa API key dan pembatasannya di Google AI Studio. ' + message);
                    throw new Error('Gagal membaca daftar model Gemini (HTTP ' + code + '): ' + message);
                }
                const entries = Array.isArray(body && body.models) ? body.models : [];
                const usable = entries.filter(item => {
                    const name = String(item && item.name || '').replace(/^models\//, '');
                    const methods = Array.isArray(item && item.supportedGenerationMethods) ? item.supportedGenerationMethods : [];
                    return /^gemini-/i.test(name) && methods.includes('generateContent') && !/(image|embedding|aqa|tts|text-to-speech|veo|robotics|computer-use|live-api)/i.test(name);
                }).map(item => ({
                    name: String(item.name).replace(/^models\//, ''),
                    displayName: String(item.displayName || item.name || '').replace(/^models\//, ''),
                    description: String(item.description || '')
                }));
                if (!usable.length) throw new Error('API key berhasil mengakses Google Gemini, tetapi tidak ada model yang melaporkan dukungan generateContent. Periksa model/API yang diaktifkan untuk proyek ini di Google AI Studio.');
                return usable;
            };

            const panggilGeminiWartaLangsung = async (pdfBase64, preferredModel) => {
                if (!pdfBase64) throw new Error('Data PDF kosong. Pilih ulang file Warta Jemaat.');
                const apiKey = await getGeminiApiKeyFromFirestore();
                const preferred = String(preferredModel || '').trim();
                if (preferred && !/^gemini-[a-zA-Z0-9._-]{1,100}$/.test(preferred)) throw new Error('Nama model tidak valid. Pilih nama model Gemini atau gunakan deteksi otomatis.');

                const available = await daftarModelGeminiTersedia(apiKey);
                const byName = new Map(available.map(item => [item.name, item]));
                const requestedAvailable = preferred ? byName.get(preferred) : null;
                const flashModels = available.filter(item => /flash/i.test(item.name));
                const stableFlash = flashModels.filter(item => !/(preview|experimental|exp|latest)/i.test(item.name));
                const previewFlash = flashModels.filter(item => /(preview|experimental|exp|latest)/i.test(item.name));
                const otherStable = available.filter(item => !/flash/i.test(item.name) && !/(preview|experimental|exp|latest)/i.test(item.name));
                const models = [];
                const addModel = item => { if (item && !models.some(model => model.name === item.name)) models.push(item); };
                addModel(requestedAvailable);
                stableFlash.forEach(addModel);
                previewFlash.forEach(addModel);
                otherStable.forEach(addModel);
                // Batasi jumlah percobaan supaya tidak menghabiskan waktu/kuota berlebihan.
                const candidates = models.slice(0, 6);
                const attempted = [];
                const failureDetails = [];
                let lastError = '';
                let quotaFailures = 0;

                for (const modelInfo of candidates) {
                    const modelName = modelInfo.name;
                    attempted.push(modelName);
                    let response;
                    let body;
                    try {
                        response = await fetch('https://generativelanguage.googleapis.com/v1beta/models/' + encodeURIComponent(modelName) + ':generateContent', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'x-goog-api-key': apiKey },
                            body: JSON.stringify({
                                contents: [{ role: 'user', parts: [
                                    { text: WARTA_PROMPT },
                                    { inline_data: { mime_type: 'application/pdf', data: pdfBase64 } }
                                ] }],
                                generationConfig: { temperature: 0.1, maxOutputTokens: 8192, responseMimeType: 'application/json' }
                            })
                        });
                        body = await response.json();
                    } catch (err) {
                        lastError = 'Tidak dapat membaca respons Google Gemini untuk model ' + modelName + '. Periksa koneksi internet dan coba lagi.';
                        continue;
                    }
                    if (response.ok && !(body && body.error)) {
                        const parts = body && body.candidates && body.candidates[0] && body.candidates[0].content && body.candidates[0].content.parts;
                        const text = Array.isArray(parts) ? parts.map(part => String((part && part.text) || '')).join('').trim() : '';
                        if (!text) {
                            const reason = body && body.candidates && body.candidates[0] && body.candidates[0].finishReason;
                            lastError = 'Model ' + modelName + ' tidak mengembalikan teks' + (reason ? ' (' + reason + ')' : '') + '.';
                            continue;
                        }
                        try {
                            const normalized = parseGeminiJson(text);
                            if (!Array.isArray(normalized.serviceEntries) || !normalized.serviceEntries.length) throw new Error('Rincian pemasukan tidak ditemukan.');
                            if (!Array.isArray(normalized.expenseEntries) || !normalized.expenseEntries.length) throw new Error('Rincian pengeluaran tidak ditemukan.');
                            window.lastGeminiWartaModel = modelName;
                            return { text: JSON.stringify(normalized), data: normalized, model: modelName };
                        } catch (err) {
                            lastError = 'Hasil model ' + modelName + ' tidak lolos pemeriksaan struktur data: ' + err.message;
                            continue;
                        }
                    }
                    const code = Number((body && body.error && body.error.code) || response.status || 0);
                    const serverMessage = body && body.error && body.error.message ? String(body.error.message) : '';
                    const apiStatus = body && body.error && body.error.status ? String(body.error.status) : '';
                    if (code === 401 || code === 403) throw new Error('API key Gemini tidak valid atau tidak memiliki izin (' + code + '). Periksa key di Google AI Studio dan pembatasan key. ' + serverMessage);
                    if (code === 429) {
                        quotaFailures++;
                        lastError = 'Kuota atau batas laju Gemini tercapai (HTTP 429)' + (apiStatus ? ' [' + apiStatus + ']' : '') + (serverMessage ? ': ' + serverMessage : '.') + ' Periksa penggunaan/kuota API key di Google AI Studio; menunggu reset kuota atau memakai key/proyek dengan kuota tersedia mungkin diperlukan.';
                        failureDetails.push(modelName + ' → 429' + (serverMessage ? ': ' + serverMessage : ''));
                        // Dua kegagalan kuota biasanya cukup untuk menghindari mengirim banyak permintaan berulang.
                        if (quotaFailures >= 2) break;
                        continue;
                    }
                    if (code === 404) lastError = 'Model ' + modelName + ' tidak ditemukan/tersedia untuk generateContent (HTTP 404)' + (serverMessage ? ': ' + serverMessage : '.') + ' Sistem akan mencoba model teks lain yang terdaftar.';
                    else if (code >= 500) lastError = 'Server Gemini mengalami gangguan pada model ' + modelName + ' (HTTP ' + code + ')' + (serverMessage ? ': ' + serverMessage : '.');
                    else lastError = 'Model ' + modelName + ' gagal (HTTP ' + code + ')' + (serverMessage ? ': ' + serverMessage : '.');
                    failureDetails.push(modelName + ' → ' + code + (apiStatus ? ' [' + apiStatus + ']' : '') + (serverMessage ? ': ' + serverMessage : ''));
                }
                const preferredNote = preferred && !requestedAvailable ? ' Model pilihan ' + preferred + ' tidak tercantum sebagai model yang tersedia untuk API key ini; sistem mencoba model yang dilaporkan tersedia.' : '';
                const attemptNote = attempted.length ? ' Model teks yang dicoba: ' + attempted.join(', ') + '.' : '';
                const detailNote = failureDetails.length ? ' Rincian: ' + failureDetails.join(' | ') + '.' : '';
                throw new Error((lastError || 'Tidak ada model Gemini yang berhasil digunakan.') + preferredNote + attemptNote + detailNote);
            };

            const analyzePdf = async () => {
                setErrorText(''); setParsed(null); setRawJson(''); setReviewed(false);
                if (!pdfFile) return setErrorText('Pilih file Warta Jemaat berformat PDF.');
                if (!confirmSendToGemini) return setErrorText('Konfirmasikan dulu bahwa PDF dan data keuangan akan dikirim ke Google Gemini untuk dianalisis.');
                if (pdfFile.type && pdfFile.type !== 'application/pdf' && !pdfFile.name.toLowerCase().endsWith('.pdf')) return setErrorText('File harus berformat PDF.');
                if (pdfFile.size > 6 * 1024 * 1024) return setErrorText('Ukuran PDF terlalu besar untuk impor warta ini. Kompres PDF hingga di bawah 6 MB terlebih dahulu.');
                setBusy(true);
                try {
                    const base64 = base64FromArrayBuffer(await pdfFile.arrayBuffer());
                    const aiResult = await panggilGeminiWartaLangsung(base64, model);
                    const data = aiResult.data;
                    setParsed(data);
                    setRawJson(JSON.stringify(data, null, 2));
                    if ((data.warnings && data.warnings.length)) {
                        setErrorText(`Berhasil dibaca dengan ${aiResult.model}, tetapi ada catatan: ` + data.warnings.join(' '));
                    } else {
                        setErrorText(`Berhasil dibaca menggunakan ${aiResult.model}. Periksa pratinjau dan cocokkan total sebelum menyimpan.`);
                    }
                } catch (e) {
                    setErrorText(e.message || 'Gagal membaca PDF.');
                } finally { setBusy(false); }
            };

            const validateEditedJson = () => {
                try {
                    const data = parseGeminiJson(rawJson);
                    setParsed(data); setRawJson(JSON.stringify(data, null, 2)); setReviewed(false); setErrorText('Hasil JSON diperbarui. Periksa tabel pratinjau sekali lagi.');
                } catch (e) { setErrorText('JSON tidak valid: ' + e.message); }
            };

            const saveImport = async () => {
                if (!parsed) return;
                if (!reviewed) return setErrorText('Centang konfirmasi setelah memeriksa hasil pembacaan sebelum menyimpan.');
                if (!(parsed.serviceEntries && parsed.serviceEntries.length) || !(parsed.expenseEntries && parsed.expenseEntries.length)) return setErrorText('Rincian pemasukan atau pengeluaran kosong. Periksa PDF/hasil AI sebelum menyimpan.');
                setSaving(true); setErrorText('');
                try {
                    const ok = await onImportWarta(parsed, (pdfFile && pdfFile.name) || 'warta-jemaat.pdf');
                    if (ok) { setParsed(null); setRawJson(''); setPdfFile(null); setReviewed(false); }
                } catch (e) { setErrorText(e.message || 'Gagal menyimpan hasil impor.'); }
                finally { setSaving(false); }
            };

            return (
                <div className="space-y-6 animate-fade-in pb-8">
                    <div>
                        <h2 className="text-xl font-bold text-gray-800 font-serif">Import Warta Jemaat dengan Gemini AI</h2>
                        <p className="text-sm text-gray-500 mt-1">Unggah PDF, periksa rincian keuangan yang dibaca AI, lalu setujui sebelum data ditulis ke Firestore.</p>
                        {window.location.protocol === 'file:' && <div className="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900"><b>Anda membuka file HTML lokal.</b> Untuk pengujian penuh Firebase, gunakan URL situs Netlify yang sudah di-deploy, bukan file dari folder Downloads. Pengujian Gemini ini juga memerlukan koneksi internet dan kuota API yang tersedia.</div>}
                    </div>
                    <div className="bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl p-4 text-sm leading-6">
                        <b>Penyimpanan API key:</b> API key disimpan langsung pada dokumen Firestore <code>systemSettings/geminiApiKey</code>. Ini sederhana untuk penggunaan internal, tetapi browser yang diberi izin membaca key dapat melihatnya melalui Developer Tools/Inspect. Hanya Administrator aktif yang dapat mengganti key; staf aktif yang berwenang dapat menggunakannya untuk membaca warta. Batasi API key di Google AI Studio dan jangan gunakan konfigurasi ini untuk dashboard publik. PDF dikirim ke Google Gemini untuk diekstrak; periksa hasil sebelum menyimpan transaksi.
                        <div className="mt-2"><a className="underline font-semibold" href="https://aistudio.google.com/app/apikey" target="_blank" rel="noreferrer">Buka Google AI Studio untuk membuat API key</a></div>
                    </div>
                    <div className="bg-white border border-gray-100 rounded-xl shadow-sm p-5 space-y-4">
                        <div className="rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm">
                            <div className="font-semibold text-gray-800">Status API key Gemini</div>
                            <p className={`mt-1 ${apiKeyConfigured ? 'text-emerald-700' : apiKeyConfigured === false ? 'text-amber-700' : 'text-gray-600'}`}>{apiKeyStatusText}</p>
                            <button type="button" onClick={refreshGeminiKeyStatus} className="mt-2 text-xs font-semibold underline text-[#0b5e46]">Periksa status lagi</button>
                        </div>
                        {currentUser && currentUser.role === 'Administrator' && (
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 items-end">
                                <FormGroup label="Gemini API key">
                                    <input type="password" autoComplete="new-password" value={apiKeyInput} onChange={e => setApiKeyInput(e.target.value)} placeholder="Tempel API key Google AI Studio" className="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm text-gray-800 outline-none focus:border-[#0b5e46]" />
                                    <p className="text-xs text-gray-500 mt-1">Key yang tersimpan tidak bisa ditampilkan kembali. Untuk mengganti, tempel key baru lalu simpan.</p>
                                </FormGroup>
                                <div className="pb-4">
                                    <button type="button" onClick={saveGeminiKeyToFirestore} disabled={savingApiKey || !apiKeyInput.trim()} className="px-5 py-2.5 bg-[#0b5e46] text-white rounded-lg text-sm font-bold disabled:opacity-50">{savingApiKey ? 'Menyimpan…' : 'Simpan API key ke Firestore'}</button>
                                </div>
                            </div>
                        )}
                        <div className="grid grid-cols-1 gap-4">
                            <FormGroup label="Model Gemini pilihan (deteksi model tersedia otomatis)">
                                <input value={model} onChange={e => setModel(e.target.value)} placeholder="Kosongkan untuk deteksi otomatis (disarankan)" className="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm text-gray-800 outline-none focus:border-[#0b5e46]" />
                                <p className="text-xs text-gray-500 mt-1">Browser mencoba model cadangan jika model utama tidak tersedia, terkena kuota, atau menghasilkan JSON tidak valid. API key tidak ditampilkan pada kolom setelah tersimpan, tetapi dapat terlihat melalui alat Developer Tools karena dibaca oleh browser.</p>
                            </FormGroup>
                        </div>
                        <FormGroup label="File Warta Jemaat (PDF)">
                            <input type="file" accept="application/pdf,.pdf" onChange={e => { setPdfFile((e.target.files && e.target.files[0]) || null); setParsed(null); setRawJson(''); setErrorText(''); setReviewed(false); }} className="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-emerald-50 file:text-emerald-800" />
                            {pdfFile && <p className="text-xs text-gray-500 mt-1">{pdfFile.name} · {(pdfFile.size / 1024 / 1024).toFixed(2)} MB</p>}
                        </FormGroup>
                        <label className="flex items-start gap-3 rounded-lg border border-gray-200 p-3 text-sm text-gray-700"><input type="checkbox" checked={confirmSendToGemini} onChange={e => setConfirmSendToGemini(e.target.checked)} className="mt-1"/><span>Saya paham file Warta PDF—termasuk rincian keuangan dan nama pemberi yang tercantum—akan dikirim ke layanan Google Gemini API untuk diekstrak. Saya memiliki izin untuk memprosesnya.</span></label>
                        <div className="flex flex-wrap gap-3 items-center">
                            <button onClick={analyzePdf} disabled={busy || !pdfFile || !confirmSendToGemini} className="px-5 py-2.5 bg-[#0b5e46] text-white rounded-lg text-sm font-bold disabled:opacity-50">{busy ? 'AI sedang membaca PDF…' : 'Baca Warta dengan Gemini AI'}</button>
                            {busy && <span className="text-xs text-gray-500">Proses dapat berlangsung beberapa saat, tergantung panjang PDF dan koneksi internet.</span>}
                        </div>
                        {errorText && <div className={`rounded-lg p-3 text-sm ${/gagal|tidak valid|periksa|kosong|login|izin|belum|backend|kuota/i.test(errorText) ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-emerald-50 text-emerald-800'}`}>{errorText}</div>}
                    </div>

                    {parsed && (
                        <div className="space-y-4">
                            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                                <div className="bg-white border rounded-xl p-4"><p className="text-xs text-gray-500">Periode laporan</p><p className="font-bold text-lg text-gray-800">{parsed.reportMonth}</p></div>
                                <div className="bg-white border rounded-xl p-4"><p className="text-xs text-gray-500">Rincian pemasukan</p><p className="font-bold text-lg text-emerald-700">{fmt(totalDetail)}</p><p className="text-xs text-gray-500">{parsed.serviceEntries.length} baris positif</p></div>
                                <div className="bg-white border rounded-xl p-4"><p className="text-xs text-gray-500">Total pengeluaran dari AI</p><p className="font-bold text-lg text-red-600">{fmt(totalExpenses)}</p><p className="text-xs text-gray-500">{parsed.expenseEntries.length} uraian</p></div>
                                <div className="bg-white border rounded-xl p-4"><p className="text-xs text-gray-500">Total/defisit di warta</p><p className="font-bold text-lg text-gray-800">{fmt(parsed.reportedDeficit)}</p><p className="text-xs text-gray-500">Defisit yang tercantum</p></div>
                            </div>
                            {Math.abs(totalDetail - Number(parsed.reportedTotalIncome || 0)) > 0 || Math.abs(totalExpenses - Number(parsed.reportedTotalExpenses || 0)) > 0 ? (
                                <div className="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-900">Ada selisih antara rincian hasil pembacaan dan total ringkasan di warta. Cocokkan tabel di bawah dengan PDF sebelum menyimpan. Total ringkasan tidak akan dimasukkan lagi sebagai transaksi untuk mencegah duplikasi.</div>
                            ) : (
                                <div className="bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-sm text-emerald-900">Rincian pemasukan dan pengeluaran cocok dengan total ringkasan yang dibaca AI. Tetap periksa nominal dan tanggal sebelum menyimpan.</div>
                            )}
                            {maybeDuplicates > 0 && <div className="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-900">Ditemukan {maybeDuplicates} kemungkinan transaksi serupa di database. Impor ini memakai ID stabil per laporan sehingga impor ulang laporan yang sama akan mengganti catatan impor sebelumnya.</div>}
                            <div className="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                                <div className="p-4 border-b"><h3 className="font-bold text-gray-800">Rincian persembahan per ibadah</h3><p className="text-xs text-gray-500 mt-1">Hanya baris nominal positif; baris total di tiap tabel tidak dimasukkan sebagai transaksi tambahan.</p></div>
                                <div className="overflow-x-auto max-h-96"><table className="w-full text-sm text-left"><thead className="sticky top-0 bg-gray-50"><tr><th className="p-3">Tanggal</th><th className="p-3">Ibadah</th><th className="p-3">Hadir</th><th className="p-3">Kanal</th><th className="p-3 text-right">Nominal</th></tr></thead><tbody className="divide-y">{parsed.serviceEntries.map((x,i)=><tr key={`${x.date}-${x.service}-${x.channel}-${i}`}><td className="p-3 whitespace-nowrap">{x.date}</td><td className="p-3">{x.service}</td><td className="p-3">{x.attendance || '-'}</td><td className="p-3">{x.channel}</td><td className="p-3 text-right font-semibold whitespace-nowrap">{fmt(x.amount)}</td></tr>)}</tbody><tfoot className="bg-gray-50 font-bold"><tr><td colSpan="4" className="p-3">Jumlah detail pemasukan</td><td className="p-3 text-right">{fmt(totalDetail)}</td></tr></tfoot></table></div>
                            </div>
                            <div className="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                                <div className="p-4 border-b"><h3 className="font-bold text-gray-800">Pengeluaran bulanan · nomor 7</h3><p className="text-xs text-gray-500 mt-1">Warta tidak mencantumkan tanggal untuk setiap pengeluaran; sistem akan menandai transaksi dengan tanggal akhir periode agar dapat difilter per bulan.</p></div>
                                <div className="overflow-x-auto"><table className="w-full text-sm text-left"><thead className="bg-gray-50"><tr><th className="p-3">Uraian</th><th className="p-3 text-right">Nominal</th></tr></thead><tbody className="divide-y">{parsed.expenseEntries.map((x,i)=><tr key={`${x.description}-${i}`}><td className="p-3">{x.description}</td><td className="p-3 text-right font-semibold whitespace-nowrap">{fmt(x.amount)}</td></tr>)}</tbody><tfoot className="bg-gray-50 font-bold"><tr><td className="p-3">Jumlah pengeluaran</td><td className="p-3 text-right">{fmt(totalExpenses)}</td></tr></tfoot></table></div>
                            </div>
                            <div className="bg-white rounded-xl border border-gray-100 shadow-sm p-5 space-y-3">
                                <h3 className="font-bold text-gray-800">Catatan umum di bawah laporan keuangan</h3>
                                <div><p className="text-xs uppercase tracking-wide text-gray-500 font-bold">Persembahan Syukur</p><p className="text-sm text-gray-700 whitespace-pre-wrap">{(parsed.notes && parsed.notes.syukur) || 'Tidak ada catatan yang terbaca.'}</p></div>
                                <div><p className="text-xs uppercase tracking-wide text-gray-500 font-bold">Perpuluhan</p><p className="text-sm text-gray-700 whitespace-pre-wrap">{(parsed.notes && parsed.notes.perpuluhan) || 'Tidak ada catatan yang terbaca.'}</p></div>
                                <div><p className="text-xs uppercase tracking-wide text-gray-500 font-bold">Persembahan Lain-lain</p><p className="text-sm text-gray-700 whitespace-pre-wrap">{(parsed.notes && parsed.notes.lainLain) || 'Tidak ada catatan yang terbaca.'}</p></div>
                                {(parsed.warnings && parsed.warnings.length) > 0 && <div className="text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-3"><b>Catatan AI:</b> {parsed.warnings.join(' ')}</div>}
                                <details className="border-t pt-3"><summary className="cursor-pointer text-sm font-semibold text-gray-600">Lihat JSON hasil ekstraksi (opsional untuk koreksi)</summary><textarea value={rawJson} onChange={e=>setRawJson(e.target.value)} rows={12} className="w-full mt-3 p-3 border rounded-lg font-mono text-xs" spellCheck="false"/><button onClick={validateEditedJson} className="mt-2 px-4 py-2 border rounded-lg text-sm font-semibold">Perbarui pratinjau dari JSON</button></details>
                                <label className="flex items-start gap-3 p-3 bg-gray-50 rounded-lg text-sm text-gray-700"><input type="checkbox" checked={reviewed} onChange={e=>setReviewed(e.target.checked)} className="mt-1"/><span>Saya sudah memeriksa nominal, periode, daftar pengeluaran, dan catatan di atas terhadap PDF. Saya memahami catatan pemberi di bawah warta hanya disimpan sebagai catatan laporan agar tidak menggandakan pemasukan.</span></label>
                                <button onClick={saveImport} disabled={saving || !reviewed} className="w-full sm:w-auto px-6 py-3 bg-[#0b5e46] text-white rounded-lg text-sm font-bold disabled:opacity-50">{saving ? 'Menyimpan ke Firestore…' : `Simpan ${parsed.serviceEntries.length + parsed.expenseEntries.length} transaksi + catatan laporan`}</button>
                            </div>
                        </div>
                    )}
                    <div className="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
                        <div className="p-4 border-b"><h3 className="font-bold text-gray-800">Riwayat laporan warta yang pernah diimpor</h3><p className="text-xs text-gray-500 mt-1">Ringkasan dan catatan umum disimpan terpisah dari transaksi agar tidak menggandakan nominal.</p></div>
                        {historyError && <p className="m-4 p-3 text-sm text-amber-800 bg-amber-50 rounded-lg">{historyError}</p>}
                        {!savedReports.length && !historyError && <p className="p-5 text-sm text-gray-500">Belum ada laporan warta yang diimpor.</p>}
                        <div className="divide-y">{savedReports.map(report => (
                            <details key={report.id} className="p-4">
                                <summary className="cursor-pointer flex flex-wrap justify-between gap-2"><span className="font-semibold text-gray-800">Periode {report.reportMonth} · {report.sourceFileName || 'Warta Jemaat'}</span><span className="text-xs text-gray-500">{(report.transactionIds || []).length} transaksi impor</span></summary>
                                <div className="grid grid-cols-1 md:grid-cols-3 gap-3 mt-3 text-sm">
                                    <div className="bg-gray-50 rounded-lg p-3"><span className="text-xs text-gray-500">Pemasukan dilaporkan</span><p className="font-bold">{fmt(report.reportedTotalIncome)}</p></div>
                                    <div className="bg-gray-50 rounded-lg p-3"><span className="text-xs text-gray-500">Pengeluaran dilaporkan</span><p className="font-bold">{fmt(report.reportedTotalExpenses)}</p></div>
                                    <div className="bg-gray-50 rounded-lg p-3"><span className="text-xs text-gray-500">Defisit dilaporkan</span><p className="font-bold">{fmt(report.reportedDeficit)}</p></div>
                                </div>
                                <div className="mt-3 space-y-2 text-sm">
                                    <p><b>Persembahan Syukur:</b> {(report.notes && report.notes.syukur) || 'Tidak ada catatan.'}</p>
                                    <p><b>Perpuluhan:</b> {(report.notes && report.notes.perpuluhan) || 'Tidak ada catatan.'}</p>
                                    <p><b>Persembahan Lain-lain:</b> {(report.notes && report.notes.lainLain) || 'Tidak ada catatan.'}</p>
                                </div>
                            </details>
                        ))}</div>
                    </div>
                    <div className="text-xs text-gray-500 leading-5">Catatan: jumlah ringkasan pemasukan dari nomor 7 hanya digunakan sebagai validasi. Rincian kanal per ibadah menjadi transaksi pemasukan. Catatan syukur/perpuluhan/lain-lain dan total ringkasan disimpan pada koleksi laporan warta, bukan sebagai transaksi tambahan.</div>
                </div>
            );
        };

        // ==========================================
        // MODALS
        // ==========================================
        const ChannelCard = ({ title, nomName, hasName, nameName }) => (
            <div className="bg-white p-3.5 rounded-xl border border-emerald-100 shadow-sm">
                <label className="block text-[11px] font-semibold text-gray-700 mb-1.5">{title}</label>
                <input type="number" name={nomName} defaultValue="0" min="0" className="w-full px-3 py-2 border border-gray-200 rounded-md text-sm outline-none focus:border-[#0b5e46] focus:ring-1 focus:ring-[#0b5e46]" />
                {hasName && (
                    <div className="mt-3">
                        <label className="block text-[11px] font-semibold text-gray-700 mb-1.5">Nama pemberi</label>
                        <input type="text" name={nameName} placeholder="Opsional" className="w-full px-3 py-2 border border-gray-200 rounded-md text-sm outline-none focus:border-[#0b5e46] focus:ring-1 focus:ring-[#0b5e46]" />
                    </div>
                )}
            </div>
        );

        const ModalTransaksi = ({ isOpen, onClose, onSave, onShowAlert }) => {
            const [jenisTx, setJenisTx] = useState('Pemasukan');

            const handleSubmit = (e) => { 
                e.preventDefault(); 
                const fd = new FormData(e.target);
                const baseTx = { jenis: jenisTx, tanggal: fd.get('tanggal'), kategori: fd.get('kategori'), rincian: fd.get('rincian') };
                let savedTxs = [];

                if (jenisTx === 'Pemasukan') {
                    const keteranganUmum = fd.get('keterangan');
                    const channels = [
                        { id: 'kantong', label: 'Kantong', nom: 'nom_kantong', nama: null }, { id: 'qris', label: 'QRIS', nom: 'nom_qris', nama: null },
                        { id: 'perpuluhan', label: 'Perpuluhan', nom: 'nom_perpuluhan', nama: 'nama_perpuluhan' }, { id: 'syukur', label: 'Syukur', nom: 'nom_syukur', nama: 'nama_syukur' },
                        { id: 'emeritus', label: 'Emeritus', nom: 'nom_emeritus', nama: 'nama_emeritus' }, { id: 'gerakan1000', label: 'Gerakan 1000', nom: 'nom_gerakan1000', nama: 'nama_gerakan1000' },
                        { id: 'lainlain', label: 'Lain-lain', nom: 'nom_lainlain', nama: null },
                    ];

                    channels.forEach(ch => {
                        const nominal = Number(fd.get(ch.nom)) || 0;
                        if (nominal > 0) {
                            const namaPemberi = ch.nama ? fd.get(ch.nama) : '';
                            let finalKeterangan = keteranganUmum;
                            if (namaPemberi) finalKeterangan = finalKeterangan ? `${namaPemberi} - ${finalKeterangan}` : namaPemberi;
                            savedTxs.push({ id: generateId(), ...baseTx, rincian: `${baseTx.rincian} (${ch.label})`, keterangan: finalKeterangan, nominal: nominal });
                        }
                    });

                    if (savedTxs.length === 0) return onShowAlert("Masukkan setidaknya satu nominal!", "error");
                } else {
                    const nominal = Number(fd.get('nominal_pengeluaran')) || 0;
                    if (nominal <= 0) return onShowAlert("Masukkan nominal pengeluaran yang valid!", "error");
                    const namaPemberi = fd.get('nama_pemberi_pengeluaran') || '';
                    const ketUmum = fd.get('keterangan') || '';
                    let finalKetArray = [];
                    if(namaPemberi) finalKetArray.push(`Penerima: ${namaPemberi}`);
                    if(ketUmum) finalKetArray.push(ketUmum);

                    savedTxs.push({ id: generateId(), ...baseTx, keterangan: finalKetArray.join(' | '), nominal: nominal });
                }

                onSave(savedTxs); 
                onClose(); 
            };

            return (
                <Modal isOpen={isOpen} onClose={onClose} title="Tambah Transaksi Baru">
                    <form onSubmit={handleSubmit}>
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 mb-2">
                            <FormGroup label="Jenis transaksi"><Select name="jenis" value={jenisTx} onChange={(e) => setJenisTx(e.target.value)}><option value="Pemasukan">Pemasukan</option><option value="Pengeluaran">Pengeluaran</option></Select></FormGroup>
                            <FormGroup label="Tanggal"><Input type="date" name="tanggal" defaultValue={new Date().toISOString().split('T')[0]} required /></FormGroup>
                            {jenisTx === 'Pemasukan' ? (
                                <div className="contents">
                                    <FormGroup label="Kategori"><Select name="kategori"><option>Persembahan Ibadah</option><option>Perpuluhan</option><option>Operasional</option><option>Lain-lain</option></Select></FormGroup>
                                    <FormGroup label="Rincian"><Input type="text" name="rincian" placeholder="Contoh: IRU" required /></FormGroup>
                                </div>
                            ) : (
                                <div className="contents">
                                    <FormGroup label="Kategori"><Select name="kategori"><option>Operasional & Rutin</option><option>Pembangunan</option><option>Diakonia</option><option>Gaji & Honor</option><option>Lain-lain</option></Select></FormGroup>
                                    <FormGroup label="Rincian"><Input type="text" name="rincian" placeholder="Contoh: Speedy & Tilpon" required /></FormGroup>
                                </div>
                            )}
                        </div>
                        {jenisTx === 'Pemasukan' ? (
                            <div className="contents">
                                <p className="text-[10px] text-gray-500 mb-3">Isi satu atau beberapa kanal persembahan. Setiap kanal disimpan sebagai dokumen transaksi terpisah.</p>
                                <div className="mb-6 border border-dashed border-emerald-300 rounded-xl p-5 bg-[#fbfaf8]">
                                    <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-4">
                                        <div className="space-y-4"><ChannelCard title="Kantong" nomName="nom_kantong" hasName={false} /><ChannelCard title="Perpuluhan" nomName="nom_perpuluhan" hasName={true} nameName="nama_perpuluhan" /><ChannelCard title="Emeritus" nomName="nom_emeritus" hasName={true} nameName="nama_emeritus" /><ChannelCard title="Lain-lain" nomName="nom_lainlain" hasName={false} /></div>
                                        <div className="space-y-4"><ChannelCard title="QRIS" nomName="nom_qris" hasName={false} /><ChannelCard title="Syukur" nomName="nom_syukur" hasName={true} nameName="nama_syukur" /><ChannelCard title="Gerakan 1000" nomName="nom_gerakan1000" hasName={true} nameName="nama_gerakan1000" /></div>
                                    </div>
                                </div>
                            </div>
                        ) : (
                            <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 mb-2">
                                <FormGroup label="Nominal (Rp)"><Input type="number" name="nominal_pengeluaran" defaultValue="" placeholder="0" min="0" required /></FormGroup>
                                <FormGroup label="Nama penerima / pihak terkait"><Input type="text" name="nama_pemberi_pengeluaran" placeholder="Opsional" /></FormGroup>
                            </div>
                        )}
                        <FormGroup label="Keterangan"><Textarea name="keterangan" placeholder="Catatan tambahan" /></FormGroup>
                        <div className="flex justify-end gap-3 mt-8 pt-4 border-t border-gray-100">
                            <button type="button" onClick={onClose} className="w-full sm:w-auto px-6 py-2.5 text-gray-700 bg-white border hover:bg-gray-50 rounded-lg text-sm font-bold">Batal</button>
                            <button type="submit" className="w-full sm:w-auto px-6 py-2.5 bg-[#0b5e46] text-white rounded-lg text-sm font-bold shadow-md">Simpan Transaksi</button>
                        </div>
                    </form>
                </Modal>
            );
        };

        const ModalEditTransaksi = ({ isOpen, onClose, onSave, transaction, onShowAlert }) => {
            if (!isOpen || !transaction) return null;
            
            const handleSubmit = (e) => {
                e.preventDefault();
                const fd = new FormData(e.target);
                const nominal = Number(fd.get('nominal'));
                
                if (nominal <= 0) return onShowAlert("Nominal harus lebih dari 0!", "error");
                
                const updatedTx = {
                    ...transaction,
                    tanggal: fd.get('tanggal'),
                    kategori: fd.get('kategori'),
                    rincian: fd.get('rincian'),
                    keterangan: fd.get('keterangan'),
                    nominal: nominal
                };
                
                onSave(updatedTx);
            };

            return (
                <Modal isOpen={isOpen} onClose={onClose} title="Edit Data Transaksi">
                    <form onSubmit={handleSubmit}>
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 mb-2">
                            <FormGroup label="Tanggal Transaksi"><Input type="date" name="tanggal" defaultValue={transaction.tanggal} required /></FormGroup>
                            <FormGroup label="Nominal (Rp)"><Input type="number" name="nominal" defaultValue={transaction.nominal} min="1" required /></FormGroup>
                        </div>
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 mb-2">
                            <FormGroup label="Kategori"><Input type="text" name="kategori" defaultValue={transaction.kategori} required /></FormGroup>
                            <FormGroup label="Rincian / Kanal"><Input type="text" name="rincian" defaultValue={transaction.rincian} required /></FormGroup>
                        </div>
                        <FormGroup label="Keterangan"><Textarea name="keterangan" defaultValue={transaction.keterangan || ''} placeholder="Catatan tambahan" /></FormGroup>
                        <div className="flex justify-end gap-3 mt-8 pt-4 border-t border-gray-100">
                            <button type="button" onClick={onClose} className="w-full sm:w-auto px-6 py-2.5 text-gray-700 bg-white border hover:bg-gray-50 rounded-lg text-sm font-bold">Batal</button>
                            <button type="submit" className="w-full sm:w-auto px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-bold shadow-md">Simpan Perubahan</button>
                        </div>
                    </form>
                </Modal>
            );
        };

        const ModalJemaat = ({ isOpen, onClose, onSave }) => {
            const handleSubmit = (e) => { 
                e.preventDefault(); 
                const fd = new FormData(e.target);
                const newJemaat = {
                    id: generateId(),
                    nama: fd.get('nama'),
                    jk: fd.get('jk'),
                    ttl: fd.get('ttl'),
                    komisi: fd.get('komisi'),
                    pekerjaan: fd.get('pekerjaan'),
                    kontak: fd.get('kontak'),
                    status: 'Aktif'
                };
                onSave(newJemaat);
                onClose(); 
            };
            return (
                <Modal isOpen={isOpen} onClose={onClose} title="Tambah Data Jemaat">
                    <form onSubmit={handleSubmit}>
                        <div className="grid grid-cols-1 md:grid-cols-2 gap-x-6">
                            <FormGroup label="Nama Lengkap"><Input type="text" name="nama" required /></FormGroup>
                            <FormGroup label="Jenis Kelamin"><Select name="jk"><option value="L">Laki-laki (L)</option><option value="P">Perempuan (P)</option></Select></FormGroup>
                            <FormGroup label="Tempat, Tanggal Lahir"><Input type="text" name="ttl" placeholder="Contoh: Jakarta, 12 Agustus 1990" /></FormGroup>
                            <FormGroup label="Klasifikasi Komisi"><Input type="text" name="komisi" placeholder="Contoh: Kaum Bapak / Pemuda" /></FormGroup>
                            <FormGroup label="Pekerjaan"><Input type="text" name="pekerjaan" placeholder="Contoh: Wiraswasta / Karyawan" /></FormGroup>
                            <FormGroup label="Nomor Kontak (HP/WA)"><Input type="text" name="kontak" placeholder="08..." /></FormGroup>
                        </div>
                        <div className="flex justify-end gap-3 mt-6">
