                                            <div><label className="text-[10px] font-bold text-gray-500 block mb-1">Worship Leader</label><Input type="text" placeholder="Nama..." value={item.worshipLeader} onChange={e=>handleBulkChange(idx, 'worshipLeader', e.target.value)} required/></div>
